# Build-time settings (Cloudflare build environment variables)
SITE_URL=https://iraideas.com
# Set to "true" on staging/preview builds only, to render draft and review content.
PUBLIC_SHOW_DRAFTS=false
# Cloudflare Turnstile site key (public). Leave empty to disable the widget.
PUBLIC_TURNSTILE_SITE_KEY=
# Google Analytics 4 measurement ID. Leave empty until approved and listed in the privacy notice.
PUBLIC_GA_ID=

{
  "name": "iraideas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-content.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "astro check && tsc -p worker --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply iraideas --local",
    "db:migrate:remote": "wrangler d1 migrations apply iraideas --remote"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/workers-types": "^5.20261005.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  }
}

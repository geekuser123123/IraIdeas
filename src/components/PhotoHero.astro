---
import { site } from '../data/site';
import { siteImage } from '../lib/images';

interface Props {
  title: string;
  lead: string;
  eyebrow?: string;
  photo?: 'shirt' | 'suit' | false; // false: compact text-only hero
  authority?: boolean; // show the "nearly 30 years" line under the buttons
  subtitle?: string; // short line between the title and the lead
  label?: boolean; // the "Tim Berry, Attorney" name tag on the photo
  rule?: boolean; // short gold line under the subtitle
  large?: boolean; // oversized title, for a person's name
  angled?: boolean; // angled bottom edge (default on)
  labelPrefix?: string; // small line above the name on the photo tag, e.g. "Instructor"
  background?: string; // optional site photo name shown behind a text-only hero
}
const { title, lead, eyebrow, photo = 'shirt', authority = false, subtitle, label = true, rule = false, large = false, angled = true, labelPrefix, background } = Astro.props;
const bgImage = background ? siteImage(background) : null;
const hasPanel = Astro.slots.has('panel');
const PHOTOS = {
  shirt: { widths: [400, 600, 861], w: 861, h: 1024, alt: 'Tim Berry, attorney, in a striped shirt with arms crossed' },
  suit: { widths: [400, 600, 768], w: 768, h: 800, alt: 'Tim Berry, attorney, in a dark suit with arms crossed' },
};
const p = photo ? PHOTOS[photo] : null;
const src = (w: number) => `/images/tim/tim-berry-${photo}-${w}.webp`;
const showVisual = Boolean(p) || hasPanel;
---

<!-- Shared page hero: Tim's photo on the right, or text only when photo={false}. -->
<section class:list={['hero', 'theme-dark', { 'hero--panel': hasPanel, 'hero--large': large, 'hero--flat': !angled, 'hero--text': !p, 'hero--solo': !showVisual, 'hero--image': bgImage }]} style={bgImage ? `--hero-image: url('${bgImage}')` : undefined}>
  <div class="container hero__grid">
    <div class="hero__copy">
      <slot name="top" />
      {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {subtitle && <p class="hero__subtitle">{subtitle}</p>}
      {rule && <span class="hero__rule" aria-hidden="true" />}
      <p class="hero__lead">{lead}</p>
      <div class="btn-row"><slot name="actions" /></div>
      {
        authority && (
          <div class="hero__authority-row">
            <img class="hero__avatar" src="/images/tim/tim-berry-shirt-400.webp" width="400" height="476" alt="" aria-hidden="true" decoding="async" />
            <p class="hero__authority">{site.authority}</p>
          </div>
        )
      }
    </div>
    {showVisual && (
    <div class="hero__visual">
      {p && (
      <img
        class="hero__photo"
        src={src(p.widths[2])}
        srcset={p.widths.map((w) => `${src(w)} ${w}w`).join(', ')}
        sizes="(min-width: 1200px) 620px, (min-width: 900px) 50vw, 85vw"
        width={p.w}
        height={p.h}
        alt={p.alt}
        fetchpriority="high"
      />
      )}
      {
        p && label && (
          <p class="hero__label">
            {labelPrefix && <span class="hero__label-prefix">{labelPrefix}</span>}
            <span class="hero__label-name">Tim Berry</span>
            <span class="hero__label-role">Attorney</span>
          </p>
        )
      }
      {hasPanel && <div class="hero__panel"><slot name="panel" /></div>}
    </div>
    )}
  </div>
</section>

<style>
  /* Hero: angled bottom edge kept from the previous design */
  .hero {
    position: relative;
    padding: clamp(48px, 6vw, 72px) 0 0;
    background:
      radial-gradient(40% 60% at 78% 42%, rgba(255, 255, 255, 0.09), transparent 70%),
      radial-gradient(60% 80% at 0% 100%, rgba(11, 27, 35, 0.55), transparent 70%),
      linear-gradient(155deg, #11524f 0%, var(--teal) 50%, var(--teal-deep) 100%);
    clip-path: polygon(0 0, 100% 0, 100% 88%, 62% 100%, 0 93%);
    overflow: hidden;
  }
  .hero__grid { display: grid; gap: 24px; align-items: end; }
  @media (min-width: 900px) {
    .hero__grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  .hero__copy { padding-bottom: clamp(80px, 10vw, 150px); }
  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 20px;
  }
  .hero__eyebrow::after { content: ''; width: 56px; height: 1px; background: rgba(255, 255, 255, 0.6); }
  .hero h1 { font-size: clamp(2.6rem, 5.4vw, 4.4rem); color: #fff; font-weight: 600; letter-spacing: -0.03em; line-height: 1.02; margin-bottom: 0.4em; }
  .hero__lead { color: rgba(227, 238, 237, 0.92); max-width: 560px; font-size: clamp(1.05rem, 1.4vw, 1.18rem); line-height: 1.65; margin-bottom: 32px; }
  .hero__authority-row { display: flex; align-items: center; gap: 14px; margin-top: 24px; }
  .hero__authority { margin: 0; color: #e3eeed; font-size: 0.95rem; }
  .hero__avatar {
    display: none;
    width: 64px;
    height: 64px;
    flex: none;
    object-fit: cover;
    object-position: 50% 6%;
    border-radius: 50%;
    border: 2px solid var(--gold);
    background: var(--teal-deep);
  }
  .hero__visual { position: relative; align-self: end; justify-self: end; width: 100%; max-width: 620px; }
  .hero__photo { position: relative; z-index: 1; width: 100%; height: auto; filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.25)); }
  /* Soft gold glow and a fine ring behind the portrait */
  .hero__visual::before { content: ''; position: absolute; left: 50%; top: 8%; width: 86%; aspect-ratio: 1; transform: translateX(-50%); border-radius: 50%; background: radial-gradient(circle, rgba(255, 180, 0, 0.18) 0%, rgba(255, 180, 0, 0.06) 45%, transparent 70%); }
  .hero__visual::after { content: ''; position: absolute; left: 50%; top: 4%; width: 78%; aspect-ratio: 1; transform: translateX(-50%); border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.14); box-shadow: 0 0 0 28px rgba(255, 255, 255, 0.025); }
  .hero--text .hero__visual::before, .hero--text .hero__visual::after { display: none; }
  /* Name tag attached to the photo */
  .hero__label {
    position: absolute;
    left: 6%;
    bottom: 16%;
    margin: 0;
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    z-index: 2;
    color: #fff;
    background: rgba(0, 46, 46, 0.72);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-left: 3px solid var(--gold);
    border-radius: 10px;
    padding: 12px 18px;
    box-shadow: 0 18px 40px -10px rgba(0, 0, 0, 0.45);
  }
  .hero__label-prefix { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mist); }
  .hero__label-name { font-family: var(--font-heading); font-weight: 700; font-size: 1.15rem; }
  .hero__label-role { font-size: 0.78rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); }
  .hero__subtitle { color: #fff; font-size: 1.25rem; margin: -4px 0 12px; }
  /* Text-only hero: compact, centred vertically, no empty space */
  .hero--text { padding-top: clamp(56px, 7vw, 96px); padding-bottom: clamp(64px, 8vw, 104px); }
  .hero--text h1 { max-width: 900px; }
  .hero--text:not(.hero--flat) { padding-bottom: clamp(96px, 12vw, 150px); }
  .hero--text .hero__copy, .hero--text.hero--flat .hero__copy { padding-bottom: 0; }
  .hero--text .hero__grid { align-items: center; }
  .hero--solo .hero__grid { grid-template-columns: 1fr; }
  .hero--solo .hero__copy { max-width: 820px; }
  .hero--text .btn-row:empty { display: none; }
  .hero--text.hero--panel .hero__visual { max-width: 380px; }
  .hero--text.hero--panel .hero__panel { position: static; transform: none; width: 100%; margin: 0; }

  /* Background photo behind a text-only hero, faded into the dark side */
  .hero--image {
    background:
      linear-gradient(180deg, rgba(0, 40, 42, 0.35) 0%, transparent 30%, transparent 70%, rgba(0, 40, 42, 0.45) 100%),
      linear-gradient(90deg, rgba(4, 28, 32, 0.97) 0%, rgba(4, 30, 34, 0.86) 42%, rgba(0, 58, 58, 0.25) 80%, rgba(0, 58, 58, 0.1) 100%),
      var(--hero-image) right center / cover no-repeat;
  }
  @media (max-width: 767px) {
    .hero--image {
      background:
        linear-gradient(180deg, rgba(4, 28, 32, 0.68) 0%, rgba(4, 28, 32, 0.86) 100%),
        var(--hero-image) 70% center / cover no-repeat;
    }
  }

  /* Straight bottom edge */
  .hero--flat, .hero.hero--flat { clip-path: none; }
  .hero--flat .hero__copy { padding-bottom: clamp(56px, 7vw, 96px); }
  .hero--large h1 { font-size: clamp(3rem, 6.5vw, 5rem); margin-bottom: 0.15em; }
  .hero--large .hero__subtitle { font-size: clamp(1.5rem, 2.6vw, 2rem); margin: 0; }
  .hero--large .hero__lead { font-size: clamp(1.2rem, 2vw, 1.45rem); color: #fff; max-width: 440px; }
  .hero__rule { display: block; width: 56px; height: 2px; background: var(--gold); margin: 20px 0 24px; }

  /* Optional information panel beside the photo */
  @media (min-width: 900px) {
    .hero--panel .hero__visual { max-width: none; }
    .hero--panel .hero__photo { width: 72%; }
    .hero__panel { position: absolute; right: 0; top: 50%; transform: translateY(-58%); width: min(320px, 52%); }
  }
  @media (max-width: 899px) {
    .hero__panel { margin: 8px 0 64px; }
  }
  @media (max-width: 899px) {
    .hero { clip-path: polygon(0 0, 100% 0, 100% 96%, 0 100%); }
    .hero__copy { padding-bottom: 8px; }
    .hero--flat .hero__copy { padding-bottom: 8px; }
    .hero--flat .hero__label { bottom: 30%; }
    .hero__avatar { display: block; }
    .hero__eyebrow::after { display: none; }
    .hero__visual { max-width: 420px; justify-self: center; }
    .hero__label { left: 0; bottom: 14%; padding: 10px 14px; }
  }

</style>

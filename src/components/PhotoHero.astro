---
import { site } from '../data/site';

interface Props {
  title: string;
  lead: string;
  eyebrow?: string;
  photo?: 'shirt' | 'suit';
  authority?: boolean; // show the "nearly 30 years" line under the buttons
}
const { title, lead, eyebrow, photo = 'shirt', authority = false } = Astro.props;
const PHOTOS = {
  shirt: { widths: [400, 600, 861], w: 861, h: 1024, alt: 'Tim Berry, attorney, in a striped shirt with arms crossed' },
  suit: { widths: [400, 600, 768], w: 768, h: 800, alt: 'Tim Berry, attorney, in a dark suit with arms crossed' },
};
const p = PHOTOS[photo];
const src = (w: number) => `/images/tim/tim-berry-${photo}-${w}.webp`;
---

<!-- Large photo hero with the angled bottom edge. Used on the homepage and About. -->
<section class="hero theme-dark">
  <div class="container hero__grid">
    <div class="hero__copy">
      {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="hero__lead">{lead}</p>
      <div class="btn-row"><slot name="actions" /></div>
      {
        authority && (
          <div class="hero__authority-row">
            <img class="hero__avatar" src="/images/tim/tim-berry-shirt-400.webp" width="400" height="476" alt="" aria-hidden="true" decoding="async" />
            <p class="hero__authority">{site.authority}</p>
          </div>
        )
      }
    </div>
    <div class="hero__visual">
      <img
        class="hero__photo"
        src={src(p.widths[2])}
        srcset={p.widths.map((w) => `${src(w)} ${w}w`).join(', ')}
        sizes="(min-width: 1200px) 620px, (min-width: 900px) 50vw, 85vw"
        width={p.w}
        height={p.h}
        alt={p.alt}
        fetchpriority="high"
      />
      <p class="hero__label">
        <span class="hero__label-name">Tim Berry</span>
        <span class="hero__label-role">Attorney</span>
      </p>
    </div>
  </div>
</section>

<style>
  /* Hero: angled bottom edge kept from the previous design */
  .hero {
    position: relative;
    padding: clamp(48px, 6vw, 72px) 0 0;
    background:
      radial-gradient(ellipse 45% 75% at 80% 45%, rgba(255, 255, 255, 0.08), transparent 70%),
      linear-gradient(160deg, #0f504e 0%, var(--teal) 55%, var(--teal-deep) 100%);
    clip-path: polygon(0 0, 100% 0, 100% 88%, 62% 100%, 0 93%);
    overflow: hidden;
  }
  .hero__grid { display: grid; gap: 24px; align-items: end; }
  @media (min-width: 900px) {
    .hero__grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  .hero__copy { padding-bottom: clamp(80px, 10vw, 150px); }
  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 20px;
  }
  .hero__eyebrow::after { content: ''; width: 56px; height: 1px; background: rgba(255, 255, 255, 0.6); }
  .hero h1 { font-size: clamp(2.5rem, 5.2vw, 4rem); color: #fff; letter-spacing: -0.02em; line-height: 1.05; }
  .hero__lead { color: #e3eeed; max-width: 560px; font-size: 1.1rem; margin-bottom: 28px; }
  .hero__authority-row { display: flex; align-items: center; gap: 14px; margin-top: 24px; }
  .hero__authority { margin: 0; color: #e3eeed; font-size: 0.95rem; }
  .hero__avatar {
    display: none;
    width: 64px;
    height: 64px;
    flex: none;
    object-fit: cover;
    object-position: 50% 6%;
    border-radius: 50%;
    border: 2px solid var(--gold);
    background: var(--teal-deep);
  }
  .hero__visual { position: relative; align-self: end; justify-self: end; width: 100%; max-width: 620px; }
  .hero__photo { width: 100%; height: auto; }
  /* Name tag attached to the photo */
  .hero__label {
    position: absolute;
    left: 6%;
    bottom: 16%;
    margin: 0;
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    color: #fff;
    background: rgba(0, 58, 58, 0.92);
    border-left: 3px solid var(--gold);
    border-radius: var(--radius);
    padding: 12px 18px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25);
  }
  .hero__label-name { font-family: var(--font-heading); font-weight: 700; font-size: 1.15rem; }
  .hero__label-role { font-size: 0.78rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); }
  @media (max-width: 899px) {
    .hero { clip-path: polygon(0 0, 100% 0, 100% 96%, 0 100%); }
    .hero__copy { padding-bottom: 8px; }
    .hero__avatar { display: block; }
    .hero__eyebrow::after { display: none; }
    .hero__visual { max-width: 420px; justify-self: center; }
    .hero__label { left: 0; bottom: 14%; padding: 10px 14px; }
  }

</style>

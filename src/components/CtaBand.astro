---
import { site } from '../data/site';
import Icon from './Icon.astro';
interface Props {
  heading: string;
  copy?: string;
  href?: string;
  label?: string;
  note?: string;
  layout?: 'center' | 'split';
  tone?: 'navy' | 'teal';
}
const { heading, copy, href = site.primaryCta.href, label = site.primaryCta.label, note, layout = 'center', tone = 'navy' } = Astro.props;
---

<section class:list={['cta-band', tone === 'teal' ? 'theme-dark' : 'theme-darker', `cta-band--${layout}`]}>
  <div class="container cta-band__inner">
    <div class="cta-band__text">
      <h2>{heading}</h2>
      {copy && <p class="cta-band__copy">{copy}</p>}
    </div>
    <div class="btn-row"><a class="btn btn--primary" href={href}>{label} <Icon name="arrow" size={18} /></a></div>
    {note && <p class="small muted cta-band__note">{note}</p>}
  </div>
</section>

<style>
  .cta-band { padding: clamp(48px, 6vw, 72px) 0; text-align: center; }
  .cta-band h2 { font-size: clamp(1.8rem, 3.4vw, 2.5rem); max-width: 980px; margin: 0 auto 12px; color: #fff; }
  .cta-band__copy { max-width: 720px; margin: 0 auto; color: #d9e3e6; }
  .cta-band .btn-row { margin-top: 28px; justify-content: center; }
  .cta-band__note { margin: 16px 0 0; }
  .cta-band.theme-dark { background: var(--teal); }
  @media (min-width: 800px) {
    .cta-band--split { text-align: left; padding: 40px 0; }
    .cta-band--split .cta-band__inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
    .cta-band--split h2 { margin: 0 0 6px; }
    .cta-band--split .cta-band__copy { margin: 0; }
    .cta-band--split .btn-row { margin-top: 0; }
  }
</style>

---
import Logo from './Logo.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
const ext = site.external;
const links = [
  { label: 'How We Work', href: '/how-we-work' },
  { label: 'Contact', href: '/contact' },
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'Disclosures', href: '/disclosures' },
];
const external = [
  ext.clientLogin && { label: 'Client Login', href: ext.clientLogin },
  ext.taxAcademy && { label: 'Plan Administration', href: ext.taxAcademy },
].filter(Boolean) as { label: string; href: string }[];
---

<footer class="site-footer theme-darker">
  <div class="container">
    <div class="site-footer__row">
      <Logo />
      <nav aria-label="Footer" class="site-footer__nav">
        <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      {
        external.length > 0 && (
          <ul class="site-footer__external">
            {external.map((l) => (
              <li>
                <a href={l.href} rel="noopener">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    {
      (site.contact.email || site.contact.phone || site.contact.address) && (
        <ul class="site-footer__contact small">
          {site.contact.address && <li>{site.contact.address}</li>}
          {site.contact.email && <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>}
          {site.contact.phone && <li><a href={`tel:${site.contact.phone.replace(/[^0-9+]/g, '')}`}>{site.contact.phone}</a></li>}
        </ul>
      )
    }
    {site.footerDisclosure && <p class="small muted site-footer__disclosure">{site.footerDisclosure}</p>}
    <p class="small muted site-footer__copy">&copy; {year} {site.legalEntityName ?? site.brand}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid rgba(255, 255, 255, 0.12); padding: 28px 0 24px; }
  .site-footer__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 40px; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 28px; }
  .site-footer li + li { margin-top: 0; }
  .site-footer a { color: #fff !important; text-decoration: none; font-size: 0.92rem; }
  .site-footer a:hover { color: var(--gold) !important; text-decoration: underline; }
  .site-footer__external li + li { border-left: 1px solid rgba(255, 255, 255, 0.3); padding-left: 28px; }
  .site-footer__contact { margin-top: 20px !important; color: var(--mist); }
  .site-footer__disclosure { margin: 16px 0 0; }
  .site-footer__copy { margin: 16px 0 0; font-size: 0.8rem; }
</style>

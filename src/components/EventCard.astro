---
import { getEntry } from 'astro:content';
import { FORMAT_LABELS, STATUS_LABELS, eventAction, formatDates, formatPrice, type EventEntry } from '../lib/content';
import DraftFlag from './DraftFlag.astro';

interface Props { event: EventEntry; headingLevel?: 'h2' | 'h3'; feature?: boolean; light?: boolean }
const { event, headingLevel = 'h3', feature = false, light = false } = Astro.props;
const d = event.data;
const instructor = await getEntry(d.instructor);
const action = eventAction(event);
const Heading = headingLevel;
---

<article class:list={['card', 'event-card', { 'event-card--feature': feature, 'card--light': light }]}>
  <DraftFlag state={d.publication} />
  <div class="event-card__meta">
    <span class="eyebrow">{FORMAT_LABELS[d.format]}</span>
    <span class:list={['badge', `status--${d.status}`]}>{STATUS_LABELS[d.status]}</span>
  </div>
  <Heading class="event-card__title"><a href={`/conferences/${event.id}`}>{d.title}</a></Heading>
  <p>{d.summary}</p>
  <dl class="event-card__facts">
    <div><dt>Dates</dt><dd>{formatDates(d.startDate, d.endDate, d.timezone)}</dd></div>
    <div><dt>Location</dt><dd>{d.location}{d.delivery !== 'in-person' && ` (${d.delivery === 'virtual' ? 'virtual' : 'in person and virtual'})`}</dd></div>
    <div><dt>Instructor</dt><dd>{instructor?.data.name ?? 'To be announced'}</dd></div>
    <div><dt>Price</dt><dd>{formatPrice(d.price)}</dd></div>
  </dl>
  {(d.status === 'postponed' || d.status === 'canceled') && d.statusNotice && <p class="event-card__notice" role="note">{d.statusNotice}</p>}
  <div class="btn-row">
    {action && <a class="btn btn--primary" href={action.href}>{action.label}</a>}
    <a class="btn btn--secondary" href={`/conferences/${event.id}`}>View Event Details</a>
  </div>
</article>

<style>
  .event-card__meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; margin-bottom: 12px; }
  .event-card__meta .eyebrow { margin: 0; }
  .event-card__title { font-family: var(--font-heading); font-weight: 700; font-size: 1.6rem; }
  .event-card__title a { color: inherit; text-decoration: none; }
  .event-card__title a:hover { text-decoration: underline; }
  .event-card__facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin: 8px 0 28px; }
  .event-card__facts dt { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--slate); }
  :global(.theme-dark) .event-card:not(.card--light) .event-card__facts dt { color: var(--mist); }
  .event-card__facts dd { margin: 2px 0 0; font-weight: 500; }
  .event-card__notice { border-left: 3px solid var(--gold); padding-left: 12px; }
  .event-card--feature { padding: clamp(28px, 4vw, 48px); }
  .event-card .btn-row { margin-top: auto; }
</style>

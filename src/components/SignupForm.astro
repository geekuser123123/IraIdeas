---
import Turnstile from './Turnstile.astro';

interface Props { list: 'learning' | 'priority'; id?: string; button?: string; stacked?: boolean; inline?: boolean }
const { list, id = `${list}-signup`, button = list === 'learning' ? 'Get Learning Updates' : 'Join the Priority List', stacked = false, inline = false } = Astro.props;
---

<form class:list={['signup-form', { 'signup-form--stacked': stacked, 'signup-form--inline': inline }]} id={id} action="/api/signup" method="post" data-list={list} novalidate={false}>
  <input type="hidden" name="list" value={list} />
  <div class="form-alert" role="alert" tabindex="-1" hidden></div>
  {
    list === 'learning' ? (
      <div class="signup-form__fields">
        {!inline && <div class="field">
          <label for={`${id}-first`}>First name <span class="optional">(optional)</span></label>
          <input id={`${id}-first`} name="first_name" type="text" autocomplete="given-name" maxlength="120" />
          <p class="field-error" data-error-for="first_name" />
        </div>}
        <div class="field">
          <label for={`${id}-email`}>Email</label>
          <input id={`${id}-email`} name="email" type="email" autocomplete="email" required maxlength="254" placeholder={inline ? 'Your email address' : undefined} />
          <p class="field-error" data-error-for="email" />
        </div>
      </div>
    ) : (
      <div class="signup-form__fields">
        <div class="field">
          <label for={`${id}-name`}>Name</label>
          <input id={`${id}-name`} name="name" type="text" autocomplete="name" required maxlength="120" />
          <p class="field-error" data-error-for="name" />
        </div>
        <div class="field">
          <label for={`${id}-email`}>Email</label>
          <input id={`${id}-email`} name="email" type="email" autocomplete="email" required maxlength="254" />
          <p class="field-error" data-error-for="email" />
        </div>
        <div class="field">
          <label for={`${id}-format`}>Event format of interest <span class="optional">(optional)</span></label>
          <select id={`${id}-format`} name="format_interest">
            <option value="">No preference</option>
            <option value="live">Broader educational events</option>
            <option value="workshop">Advanced workshops</option>
            <option value="private-session">Private planning sessions</option>
          </select>
        </div>
      </div>
    )
  }
  <Turnstile />
  {list === 'priority' && <p class="small muted">Joining the priority list does not reserve a seat or guarantee admission.</p>}
  <button class="btn btn--primary" type="submit">{button}</button>
</form>

<script>
  import { enhanceForm } from '../lib/forms';
  document.querySelectorAll<HTMLFormElement>('.signup-form').forEach((form) => {
    const list = form.dataset.list!;
    enhanceForm(form, {
      successEvent: list === 'priority' ? 'priority_list_signup' : 'learning_signup',
      eventProps: (f) => ({ list, format: (f.elements.namedItem('format_interest') as HTMLSelectElement | null)?.value || undefined }),
    });
  });
</script>

<style>
  .signup-form { max-width: 640px; }
  @media (min-width: 640px) {
    .signup-form:not(.signup-form--stacked) .signup-form__fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0 20px; }
    .signup-form__fields .field:nth-child(3) { grid-column: 1 / -1; }
  }
  :global(.theme-dark) .signup-form label { color: var(--light); }
  :global(.theme-dark) .signup-form .optional { color: var(--mist); }
  /* Inline: email and button on one row (learning list only) */
  .signup-form--inline { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-start; max-width: 680px; }
  .signup-form--inline .signup-form__fields { flex: 1 1 280px; display: block !important; }
  .signup-form--inline .field { margin: 0; }
  .signup-form--inline label { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .signup-form--inline .form-alert { flex-basis: 100%; }
  .signup-form--inline .btn { flex: 0 0 auto; }
</style>

---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { site } from '../data/site';

interface Props { tone?: 'light' | 'dark' }
const { tone = 'light' } = Astro.props;

// The "iRA" lightbulb mark (transparent WebP, trimmed). Falls back to a text
// mark if the file is ever removed.
const MARK = '/images/logo/ira-mark.webp';
const hasMark = existsSync(join(process.cwd(), 'public', MARK));
---

<a href="/" class:list={['logo', `logo--${tone}`]} aria-label={`${site.brand} home`}>
  {
    hasMark ? (
      <img class="logo__mark" src={MARK} alt="" width="395" height="138" />
    ) : (
      <span class="logo__mark-text" aria-hidden="true">
        iRA <span class="logo__ideas">Ideas</span>
      </span>
    )
  }
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 14px; text-decoration: none; line-height: 1; }
  /* The image already contains "IDEAS LLC" in white, so it needs a dark background. */
  .logo__mark { height: 48px; width: auto; }
  .logo__mark-text { font-family: var(--font-heading); font-weight: 700; font-style: italic; font-size: 2.2rem; color: var(--gold); }
  .logo__ideas { font-style: normal; font-size: 1.2rem; letter-spacing: 0.08em; text-transform: uppercase; color: #fff; }
  @media (max-width: 420px) {
    .logo { gap: 10px; }
    .logo__mark { height: 40px; }
  }
</style>

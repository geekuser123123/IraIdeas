---
import { site } from '../data/site';
interface Props { tone?: 'light' | 'dark' }
const { tone = 'light' } = Astro.props;
---

<a href="/" class:list={['logo', `logo--${tone}`]} aria-label={`${site.brand} home`}>
  <span class="logo__name">{site.brand}</span>
  <span class="logo__descriptor">{site.descriptor}</span>
</a>

<style>
  .logo { display: inline-flex; flex-direction: column; text-decoration: none; line-height: 1.1; }
  .logo__name { font-family: var(--font-heading); font-size: 1.6rem; letter-spacing: 0.01em; }
  .logo__descriptor {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: 4px;
  }
  .logo--light .logo__name { color: var(--warm-white); }
  .logo--light .logo__descriptor { color: var(--gold); }
  .logo--dark .logo__name { color: var(--ink); }
  .logo--dark .logo__descriptor { color: var(--gold-deep); }
  @media (max-width: 420px) {
    .logo__name { font-size: 1.35rem; }
    .logo__descriptor { font-size: 0.6rem; letter-spacing: 0.1em; }
  }
</style>

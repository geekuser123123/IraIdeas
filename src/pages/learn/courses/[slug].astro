---
import { getEntry, getEntries, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import DraftFlag from '../../../components/DraftFlag.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { visible, formatDay, SHOW_DRAFTS } from '../../../lib/content';

export async function getStaticPaths() {
  const courses = await visible('courses');
  return courses.map((course) => ({ params: { slug: course.id }, props: { course } }));
}

const { course } = Astro.props;
const d = course.data;
const instructor = await getEntry(d.instructor);
const services = (await getEntries(d.relatedServices)).filter((s) => s && (SHOW_DRAFTS || s.data.publication === 'published'));
const supporting = (await getEntries(d.supportingResources)).filter((r) => r && (SHOW_DRAFTS || r.data.publication === 'published'));
const isReleased = async (id?: string) => {
  if (!id) return false;
  const r = await getEntry('resources', id);
  return Boolean(r && (SHOW_DRAFTS || r.data.publication === 'published'));
};
const modules = await Promise.all(
  d.modules.map(async (m) => ({ ...m, lessons: await Promise.all(m.lessons.map(async (l) => ({ ...l, released: await isReleased(l.resource?.id) }))) })),
);
const { Content } = await render(course);
---

<Base title={d.title} description={d.description} noindex={d.publication !== 'published'}>
  <section class="course-hero theme-dark">
    <div class="container">
      <div class="reading">
        <nav aria-label="Breadcrumb" class="crumbs small"><a href="/learn">Advanced Learning</a> <span aria-hidden="true">/</span> Courses</nav>
        <DraftFlag state={d.publication} />
        <p class="eyebrow">IRA Ideas Advanced Learning{d.entirelyFree && <> &middot; Free course</>}</p>
        <h1>{d.title}</h1>
        <p class="lead">{d.description}</p>
        <p class="small muted">
          For {d.audience}{instructor && <> &middot; Taught by {instructor.data.name}</>}{d.reviewedDate && <> &middot; Reviewed {formatDay(d.reviewedDate)}</>}
        </p>
      </div>
    </div>
  </section>

  <div class="container section course-body">
    {d.objectives.length > 0 && <section><h2>What you will learn</h2><ul class="checklist">{d.objectives.map((o) => <li>{o}</li>)}</ul></section>}
    {d.prerequisites.length > 0 && <section><h2>Before you begin</h2><ul>{d.prerequisites.map((p) => <li>{p}</li>)}</ul></section>}
    <div class="prose"><Content /></div>
    {modules.length > 0 && (
      <section>
        <h2>Modules</h2>
        {modules.map((m, i) => (
          <div class="module">
            <h3>Module {i + 1}: {m.title}</h3>
            <ol>
              {m.lessons.map((l) => (
                <li>{l.released && l.resource ? <a href={`/learn/${l.resource.id}`}>{l.title}</a> : <>{l.title} <span class="muted small">(not yet released)</span></>}</li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    )}
    {supporting.length > 0 && <section><h2>Supporting resources</h2><ul>{supporting.map((r) => <li><a href={`/learn/${r!.id}`}>{r!.data.title}</a></li>)}</ul></section>}
    {services.length > 0 && <section><h2>Related services</h2><ul>{services.map((s) => <li><a href={`/advanced-services/${s!.id}`}>{s!.data.name}</a></li>)}</ul></section>}
  </div>

  <CtaBand heading="Working through a situation involving this topic?" copy="Tell our team what you are considering and we will identify the appropriate next step." />
</Base>

<style>
  .course-hero { padding: clamp(48px, 7vw, 80px) 0; }
  .crumbs { margin-bottom: 20px; color: var(--mist); }
  .course-body > * { max-width: var(--reading); }
  .course-body section + section, .course-body .prose + section { margin-top: 48px; }
  .module + .module { margin-top: 24px; }
</style>

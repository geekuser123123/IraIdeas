---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { visible, listedEvents, isUpcoming, formatDates, SHOW_DRAFTS } from '../../lib/content';

const tim = (await getEntry('people', 'tim-berry'))!;
const { Content } = await render(tim);
const hasBio = Boolean(tim.body && tim.body.replace(/<!--[\s\S]*?-->/g, '').trim());
const resources = (await visible('resources')).filter((r) => r.data.author.id === 'tim-berry');
const events = (await listedEvents()).filter((e) => isUpcoming(e) && e.data.instructor.id === 'tim-berry');

const offerings = [
  { icon: 'document', title: 'Advanced Services', copy: 'Specialized review and defined work for significant planning decisions.', href: '/advanced-services' },
  { icon: 'people', title: 'Conferences', copy: 'Focused events built around advanced concepts and practical discussion.', href: '/conferences' },
  { icon: 'book', title: 'Advanced Learning', copy: 'Education on the strategies and structures behind important decisions.', href: '/learn' },
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tim Berry',
  jobTitle: 'Attorney',
  image: new URL('/images/tim/tim-berry-shirt-861.webp', Astro.site).href,
  worksFor: { '@type': 'Organization', name: 'IRA Ideas', url: Astro.site?.href },
};
---

<Base title="Tim Berry, Attorney" description="Tim Berry is the attorney behind IRA Ideas, with nearly 30 years of retirement-plan experience." jsonLd={jsonLd}>
  <PhotoHero title="Tim Berry" subtitle="Attorney" lead="Nearly 30 years of retirement-plan experience." label={false} rule large>
    <nav slot="top" aria-label="Breadcrumb" class="crumbs">
      <a href="/about">About</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Tim Berry</span>
    </nav>
    <Fragment slot="actions">
      <a class="btn btn--primary" href="/start">Discuss My Situation <Icon name="arrow" size={18} /></a>
    </Fragment>
  </PhotoHero>

  <section class="section">
    <div class="container">
      <div class="intro">
        <div class="intro__copy">
          <h2>Experience behind IRA Ideas.</h2>
          <p>
            Attorney Tim Berry's nearly 30 years of retirement-plan experience are central to IRA Ideas. His expertise is at the center of the
            advanced services, focused conferences, and educational resources offered through IRA Ideas.
          </p>
          <p>Our team helps organize the information, communication, and next steps around each engagement.</p>
        </div>
        <aside class="through" aria-labelledby="through-title">
          <div class="through__head">
            <h2 id="through-title">Through IRA Ideas</h2>
            <p>Explore the ways the IRA Ideas team can help.</p>
          </div>
          <ul role="list">
            {
              offerings.map((o) => (
                <li>
                  <a href={o.href}>
                    <Icon name={o.icon} size={40} class="through__icon" />
                    <span>
                      <strong>{o.title}</strong>
                      <span>{o.copy}</span>
                    </span>
                    <Icon name="chevron" size={22} class="through__chevron" />
                  </a>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>

      {
        (hasBio || tim.data.credentials.length > 0) && (
          <div class="bio">
            <h2>Professional biography</h2>
            {hasBio && (
              <div class="prose">
                <Content />
              </div>
            )}
            {tim.data.credentials.length > 0 && (
              <>
                <h3>Credentials</h3>
                <ul>
                  {tim.data.credentials.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              </>
            )}
          </div>
        )
      }
      {
        !hasBio && SHOW_DRAFTS && (
          <div class="bio">
            <h2>Professional biography</h2>
            <p class="draft-flag" role="note">
              Staging preview: add Tim's approved biography and verified credentials to src/content/people/tim-berry.md. This section stays hidden on the
              live site until then.
            </p>
          </div>
        )
      }

      <div class="links">
        <article class="link-card">
          <Icon name="book" size={48} class="link-card__icon" />
          <div>
            <h2>Educational contributions</h2>
            {
              resources.length > 0 ? (
                <ul class="link-card__list">
                  {resources.slice(0, 4).map((r) => (
                    <li>
                      <a href={`/learn/${r.id}`}>{r.data.title}</a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p>Join the learning list to hear when new educational resources are published.</p>
              )
            }
            <a class="link-card__cta" href={resources.length > 0 ? '/learn' : '/learn#learning-signup'}>
              {resources.length > 0 ? 'View Resources' : 'Get Learning Updates'} <Icon name="arrow" size={18} />
            </a>
          </div>
        </article>
        <article class="link-card">
          <Icon name="calendar" size={48} class="link-card__icon" />
          <div>
            <h2>Upcoming IRA Ideas events</h2>
            {
              events.length > 0 ? (
                <ul class="link-card__list">
                  {events.slice(0, 3).map((e) => (
                    <li>
                      <a href={`/conferences/${e.id}`}>{e.data.title}</a>
                      <span class="link-card__meta">{formatDates(e.data.startDate, e.data.endDate, e.data.timezone)}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p>Join the priority list for event announcements.</p>
              )
            }
            <a class="link-card__cta" href={events.length > 0 ? '/conferences' : '/conferences#priority-list'}>
              {events.length > 0 ? 'View Conferences' : 'Join the Priority List'} <Icon name="arrow" size={18} />
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <CtaBand heading="To discuss a potential engagement, start with the IRA Ideas team." layout="split" tone="teal" />
</Base>

<style>
  .crumbs { display: flex; gap: 8px; font-size: 0.9rem; margin-bottom: 24px; color: var(--mist); }
  .crumbs a { color: #fff !important; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }

  /* Intro and offerings card */
  .intro { display: grid; gap: 48px; align-items: start; }
  @media (min-width: 900px) {
    .intro { grid-template-columns: 1.15fr 1fr; gap: 72px; }
  }
  .intro__copy h2 { font-size: clamp(2.2rem, 4.4vw, 3.4rem); }
  .intro__copy p { color: var(--slate); font-size: 1.08rem; }
  .through { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 1px 2px rgba(11, 27, 35, 0.04); }
  .through__head { padding: 28px 28px 20px; }
  .through__head h2 { font-size: 1.8rem; margin-bottom: 6px; }
  .through__head p { color: var(--slate); margin: 0; }
  .through ul { list-style: none; margin: 0; padding: 0; }
  .through li { margin: 0; border-top: 1px solid var(--line); }
  .through a { display: flex; align-items: center; gap: 20px; padding: 20px 24px 20px 28px; color: var(--ink); text-decoration: none; }
  .through a:hover { background: var(--light); }
  .through a > span { flex: 1; }
  .through strong { display: block; font-family: var(--font-heading); font-size: 1.15rem; }
  .through a span span { display: block; color: var(--slate); font-size: 0.92rem; line-height: 1.45; }
  .through :global(.through__icon) { flex: none; color: var(--teal); }
  .through :global(.through__chevron) { flex: none; color: var(--teal); }

  /* Biography */
  .bio { border-top: 1px solid var(--line); margin-top: clamp(48px, 6vw, 72px); padding-top: clamp(40px, 5vw, 56px); }
  .bio h2 { font-size: clamp(1.9rem, 3.4vw, 2.6rem); }

  /* Resource and event cards */
  .links { display: grid; gap: 20px; border-top: 1px solid var(--line); margin-top: clamp(48px, 6vw, 72px); padding-top: clamp(40px, 5vw, 56px); }
  @media (min-width: 800px) {
    .links { grid-template-columns: 1fr 1fr; }
  }
  .link-card { display: flex; gap: 28px; align-items: flex-start; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 32px; }
  .link-card :global(.link-card__icon) { flex: none; color: var(--teal); }
  .link-card h2 { font-size: clamp(1.5rem, 2.6vw, 1.9rem); margin-bottom: 10px; }
  .link-card p { color: var(--slate); }
  .link-card__list { list-style: none; padding: 0; margin: 0 0 16px; }
  .link-card__meta { display: block; font-size: 0.88rem; color: var(--slate); }
  .link-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    color: var(--teal);
    text-decoration: none;
    border-bottom: 1.5px solid currentColor;
    padding-bottom: 2px;
  }
  .link-card__cta:hover { color: var(--ink); }
  @media (max-width: 500px) {
    .link-card { flex-direction: column; gap: 16px; padding: 24px; }
  }
</style>

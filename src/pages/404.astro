---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found" description="The page you were looking for could not be found." noindex>
  <section class="section">
    <div class="container">
      <div class="reading">
        <p class="eyebrow">Page not found</p>
        <h1>We could not find that page.</h1>
        <p class="lead">It may have moved, or the link may be incomplete.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/start">Discuss My Situation</a>
          <a class="btn btn--secondary" href="/">Go to the homepage</a>
        </div>
      </div>
    </div>
  </section>
</Base>

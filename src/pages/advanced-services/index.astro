---
import Base from '../../layouts/Base.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import DraftFlag from '../../components/DraftFlag.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORIES, CATEGORY_SLUGS } from '../../data/categories';
import { visible, formatPrice } from '../../lib/content';

const services = (await visible('services')).sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));

const steps = [
  { icon: 'chat', title: 'Tell us about your situation', copy: 'Share your objective, what is already in place, and any deadline.' },
  { icon: 'document', title: 'Review the proposed engagement', copy: 'The proposal identifies the responsible provider, the work included, and the fee.' },
  { icon: 'handshake', title: 'Approve before work begins', copy: 'Paid work begins only after the scope and fee are agreed.' },
] as const;
---

<Base
  title="Advanced Services"
  description="Specialized services for retirement planning, trusts, ownership structures, and complex transactions from IRA Ideas, with attorney Tim Berry."
>
  <PhotoHero
    eyebrow="Advanced Services"
    title="Advanced questions deserve more than a general answer."
    lead="Explore specialized services for retirement planning, trusts, ownership structures, and complex transactions. Start with a service you recognize, or tell us what you are trying to accomplish."
  >
    <Fragment slot="actions">
      <a class="btn btn--primary" href="/start">Discuss My Situation</a>
      <a class="btn btn--secondary" href="#directory">Browse Services</a>
    </Fragment>
  </PhotoHero>

  <!-- Directory -->
  <section class="section" id="directory" tabindex="-1">
    <div class="container">
      <div class="section-head">
        <h2 class="directory__title">Explore Advanced Services</h2>
        <p class="lead">Start with a service you recognize, or browse by topic.</p>
      </div>
      {
        services.length > 0 ? (
          <>
            <div class="filters" data-filters hidden>
              <label class="search">
                <span class="visually-hidden">Search services</span>
                <Icon name="search" size={20} class="search__icon" />
                <input id="service-search" type="search" placeholder="Search services by keyword" autocomplete="off" />
              </label>
              <div class="chips" role="group" aria-label="Filter by topic">
                <button type="button" class="chip" data-category="all" aria-pressed="true">
                  All
                </button>
                {CATEGORY_SLUGS.map((c) => (
                  <button type="button" class="chip" data-category={c} aria-pressed="false">
                    {CATEGORIES[c].short}
                  </button>
                ))}
              </div>
            </div>
            <p class="visually-hidden" data-results aria-live="polite" />
            <ul class="service-list" role="list">
              {services.map((s) => (
                <li
                  class={`service-card service-card--${s.data.category}`}
                  data-category={s.data.category}
                  data-search={`${s.data.name} ${s.data.subtitle} ${s.data.summary} ${CATEGORIES[s.data.category].label}`.toLowerCase()}
                >
                  <span class="service-card__icon" aria-hidden="true">
                    <Icon name={CATEGORIES[s.data.category].icon} size={28} />
                  </span>
                  <div class="service-card__body">
                    <DraftFlag state={s.data.publication} />
                    <p class="service-card__topic">{CATEGORIES[s.data.category].short}</p>
                    <h3>{s.data.name}</h3>
                    <p class="service-card__subtitle">{s.data.subtitle}</p>
                    <p class="service-card__summary">{s.data.summary}</p>
                    {s.data.fee.display !== 'none' && s.data.fee.amount != null && (
                      <p class="service-card__fee">
                        {s.data.fee.display === 'starting' ? 'Starting at ' : 'Fee: '}
                        {formatPrice(s.data.fee.amount)}
                      </p>
                    )}
                    <a class="service-card__link" href={`/advanced-services/${s.id}`}>
                      View Service <Icon name="arrow" size={18} />
                      <span class="visually-hidden">: {s.data.name}</span>
                    </a>
                  </div>
                </li>
              ))}
            </ul>
            <p class="no-results" data-empty hidden>
              No services match your search. <a href="/start">Tell us what you are working on</a> and our team will identify the right next step.
            </p>
          </>
        ) : (
          <div class="empty">
            <p>
              Detailed service descriptions are being prepared for publication. In the meantime, tell us what you are working on and our
              team will identify the appropriate next step.
            </p>
            <a class="btn btn--primary" href="/start">
              Discuss My Situation <Icon name="arrow" size={18} />
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- Not sure where to start -->
  <section class="section theme-dark diagnose">
    <div class="container diagnose__grid">
      <div>
        <h2>You do not need to diagnose the issue yourself.</h2>
        <p class="lead">
          Tell us what you want to accomplish and what is already in place. Our team will review the information and identify whether a
          consultation, assessment, or defined project is the appropriate next step.
        </p>
        <a class="btn btn--primary" href="/start">Discuss My Situation</a>
      </div>
      <div class="diagnose__media">
        <img
          src="/images/tim/tim-berry-suit-768.webp"
          srcset="/images/tim/tim-berry-suit-400.webp 400w, /images/tim/tim-berry-suit-600.webp 600w, /images/tim/tim-berry-suit-768.webp 768w"
          sizes="(min-width: 900px) 400px, 75vw"
          width="768"
          height="800"
          alt="Tim Berry, attorney"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Clear scope. Agreed fees.</h2>
        <p class="lead">
          The work required depends on the situation. Before paid work begins, the proposed engagement will identify the responsible provider,
          the work included, and the fee.
        </p>
      </div>
      <ol class="fee-steps" role="list">
        {
          steps.map((step, i) => (
            <li class={`fee-step fee-step--${i + 1}`}>
              <span class="fee-step__icon" aria-hidden="true">
                <Icon name={step.icon} size={30} />
              </span>
              <h3>
                <span class="visually-hidden">Step {i + 1}: </span>
                {step.title}
              </h3>
              <p>{step.copy}</p>
              {i < steps.length - 1 && <Icon name="arrow" size={20} class="fee-step__arrow" />}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand
    heading="Let's explore how we can help."
    copy="Tell our team what you are considering, what is already in place, and any deadline."
    note="Any proposed paid work will have a defined scope and fee before it begins."
  />
</Base>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-filters]');
  if (wrap) {
    wrap.hidden = false;
    const chips = [...wrap.querySelectorAll<HTMLButtonElement>('[data-category]')];
    const search = wrap.querySelector<HTMLInputElement>('#service-search')!;
    const cards = [...document.querySelectorAll<HTMLElement>('.service-card')];
    const results = document.querySelector<HTMLElement>('[data-results]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    let category = new URLSearchParams(location.search).get('category') || 'all';
    if (!chips.some((c) => c.dataset.category === category)) category = 'all';

    const apply = () => {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const match = (category === 'all' || card.dataset.category === category) && (!q || card.dataset.search!.includes(q));
        card.hidden = !match;
        if (match) shown++;
      }
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.category === category)));
      results.textContent = `Showing ${shown} of ${cards.length} services`;
      empty.hidden = shown > 0;
    };
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        category = chip.dataset.category!;
        const url = new URL(location.href);
        if (category === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', category);
        history.replaceState(null, '', url);
        apply();
      }),
    );
    search.addEventListener('input', apply);
    apply();
  }
</script>

<style>
  .directory__title { font-size: clamp(2.2rem, 4.5vw, 3.4rem); }

  /* Search and topic filters */
  .filters { margin-bottom: 28px; }
  .search { position: relative; display: block; margin-bottom: 20px; }
  .search :global(.search__icon) { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: var(--slate); pointer-events: none; }
  .search input { min-height: 56px; padding-left: 52px; border-color: #c9cfcd; border-radius: var(--radius); font-size: 1.05rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip {
    min-height: 44px;
    padding: 8px 22px;
    border-radius: 999px;
    border: 1px solid #c9cfcd;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
  }
  .chip:hover { border-color: var(--teal); }
  .chip[aria-pressed='true'] { background: var(--teal-deep); border-color: var(--teal-deep); color: #fff; }

  /* Service cards */
  .service-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
  @media (min-width: 900px) {
    .service-list { grid-template-columns: 1fr 1fr; }
  }
  .service-list li + li { margin-top: 0; }
  .service-card { display: flex; gap: 20px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
  .service-card[hidden] { display: none; }
  .service-card__icon { flex: none; display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; color: var(--teal); }
  .service-card--retirement-roth .service-card__icon { background: #e3eeec; }
  .service-card--trusts-wealth-transfer .service-card__icon { background: #e4ecf3; color: #1f4e6b; }
  .service-card--ownership-transactions .service-card__icon { background: #f6ecd8; color: #7a5600; }
  .service-card--plan-transaction-concerns .service-card__icon { background: #e6efe6; color: #2f5f3a; }
  .service-card__body { flex: 1; min-width: 0; }
  .service-card__topic { font-size: 0.78rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--slate); margin: 4px 0 8px; }
  .service-card h3 { font-family: var(--font-heading); font-weight: 700; font-size: 1.45rem; margin-bottom: 4px; }
  .service-card__subtitle { color: var(--teal); font-weight: 500; margin-bottom: 6px; }
  .service-card__summary { color: var(--slate); }
  .service-card__fee { font-size: 0.92rem; color: var(--slate); }
  .service-card__link { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; color: var(--teal); text-decoration: none; }
  .service-card__link:hover { text-decoration: underline; }
  .no-results { margin-top: 24px; }
  .empty { background: var(--light); border: 1px solid var(--line); border-radius: var(--radius); padding: 32px; max-width: var(--reading); }

  /* Diagnose */
  .diagnose__grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) {
    .diagnose__grid { grid-template-columns: 1fr 1fr; gap: 64px; }
  }
  .diagnose h2 { font-size: clamp(1.9rem, 3.6vw, 2.8rem); color: #fff; }
  .diagnose .lead { color: #e3eeed; margin-bottom: 28px; }
  .diagnose__media {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    background:
      radial-gradient(ellipse 60% 70% at 50% 35%, #ffffff 0%, transparent 70%),
      linear-gradient(160deg, #e8eeed 0%, #d5e1df 100%);
  }
  .diagnose__media img { width: 62%; height: auto; margin-bottom: -4%; }

  /* Fee steps */
  .fee-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 32px; }
  @media (min-width: 900px) {
    .fee-steps { grid-template-columns: repeat(3, 1fr); gap: 0; }
    .fee-step { padding: 0 48px; border-left: 1px solid var(--line); }
    .fee-step:first-child { padding-left: 0; border-left: 0; }
  }
  .fee-steps li + li { margin-top: 0; }
  .fee-step { position: relative; }
  .fee-step__icon { display: grid; place-items: center; width: 68px; height: 68px; border-radius: 50%; margin-bottom: 18px; color: var(--teal); background: #e3eeec; }
  .fee-step--2 .fee-step__icon { background: #e4ecf3; color: #1f4e6b; }
  .fee-step--3 .fee-step__icon { background: #f6ecd8; color: #7a5600; }
  .fee-step h3 { font-family: var(--font-heading); font-weight: 700; font-size: 1.3rem; }
  .fee-step p { color: var(--slate); margin: 0; }
  .fee-step :global(.fee-step__arrow) { display: none; }
  @media (min-width: 900px) {
    .fee-step :global(.fee-step__arrow) { display: block; position: absolute; right: 14px; top: 50%; color: var(--ink); }
  }
</style>

---
import { getEntries } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import DraftFlag from '../../components/DraftFlag.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORIES } from '../../data/categories';
import { visible, formatPrice, SHOW_DRAFTS } from '../../lib/content';
import { bands, bandClass } from '../../lib/bands';

export async function getStaticPaths() {
  const services = await visible('services');
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const d = service.data;
const startHref = `/start?service=${service.id}`;
const related = (await getEntries(d.relatedLearning)).filter((r) => r && (SHOW_DRAFTS || r.data.publication === 'published'));

type Point = string | { title: string; text: string };
const asPoint = (p: Point) => (typeof p === 'string' ? { title: '', text: p } : p);
const RELEVANCE_ICONS = ['person', 'list', 'chat'] as const;
const INCLUDE_ICONS = ['document', 'chart', 'handshake'] as const;

const defaultSteps = [
  { title: 'Request', text: 'Share your objective, what is already in place, and any deadline.' },
  { title: 'Team review', text: 'The team reviews the request and may ask for more detail.' },
  { title: 'Proposed engagement', text: 'Any proposed engagement identifies the provider, deliverables, exclusions, and fee before paid work begins.' },
];
const steps = d.howToBegin ? d.howToBegin.map((text, i) => ({ title: `Step ${i + 1}`, text })) : defaultSteps;

// In-page navigation lists only the sections this service actually has.
const tabs = [
  { id: 'overview', label: 'Overview', show: true },
  { id: 'relevant', label: 'When Relevant', show: d.relevance.length > 0 },
  { id: 'questions', label: 'Questions', show: d.questions.length > 0 },
  { id: 'included', label: "What's Included", show: d.includes.length > 0 || d.exclusions.length > 0 },
  { id: 'begin', label: 'How to Begin', show: true },
  { id: 'learning', label: 'Related Learning', show: related.length > 0 },
  { id: 'faqs', label: 'FAQs', show: d.faqs.length > 0 },
].filter((t) => t.show);

// Alternate section backgrounds across whichever sections this service has.
// The tab bar above them is white.
const bg = bands(
  [
    d.relevance.length > 0 && 'relevant',
    d.questions.length > 0 && 'questions',
    (d.includes.length > 0 || d.exclusions.length > 0) && 'included',
    'begin',
    related.length > 0 && 'learning',
    d.faqs.length > 0 && 'faqs',
  ],
  {},
  'white',
);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: d.name,
    description: d.summary,
    provider: { '@type': 'Organization', name: 'IRA Ideas', url: Astro.site?.href },
  },
  d.faqs.length > 0 && {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  },
].filter(Boolean) as Record<string, unknown>[];
---

<Base title={d.name} description={`${d.subtitle}. ${d.summary}`} noindex={d.publication !== 'published'} jsonLd={jsonLd}>
  <PhotoHero title={d.name} subtitle={d.subtitle} lead={d.summary} photo={false}>
    <Fragment slot="top">
      <nav aria-label="Breadcrumb" class="crumbs">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/advanced-services">Advanced Services</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{CATEGORIES[d.category].short}</span>
      </nav>
      <DraftFlag state={d.publication} />
    </Fragment>
    <Fragment slot="actions">
      <a class="btn btn--primary" href={startHref}>Discuss This Service <Icon name="arrow" size={18} /></a>
    </Fragment>
    <aside slot="panel" class="engage" aria-labelledby="engage-title">
      <h2 id="engage-title" class="engage__title">Engagement information</h2>
      <ul class="engage__list" role="list">
        <li>
          <Icon name="document" size={30} />
          <span><strong>Defined scope</strong>The proposed engagement identifies the work included.</span>
        </li>
        <li>
          <Icon name="tag" size={30} />
          <span>
            <strong>{d.fee.display !== 'none' && d.fee.amount != null ? (d.fee.display === 'starting' ? `From ${formatPrice(d.fee.amount)}` : formatPrice(d.fee.amount)) : 'Agreed fee'}</strong>
            {d.fee.note ?? 'The fee is agreed before any paid work begins.'}
          </span>
        </li>
        <li>
          <Icon name="people" size={30} />
          <span><strong>Team-led next steps</strong>The IRA Ideas team coordinates each step with you.</span>
        </li>
      </ul>
    </aside>
  </PhotoHero>

  <nav class="tabs" aria-label="On this page">
    <div class="container">
      <ul role="list">
        {tabs.map((t, i) => <li><a href={`#${t.id}`} aria-current={i === 0 ? 'true' : undefined}>{t.label}</a></li>)}
      </ul>
    </div>
  </nav>

  <span id="overview" class="anchor" aria-hidden="true"></span>

  {
    d.relevance.length > 0 && (
      <section class:list={['section', bandClass(bg.relevant)]} id="relevant">
        <div class="container two-col">
          <div>
            <h2>When this may be relevant.</h2>
            <p class="lead">This service may be worth considering in situations such as these.</p>
          </div>
          <ul class="point-list" role="list">
            {d.relevance.map(asPoint).map((p, i) => (
              <li class="point">
                <Icon name={RELEVANCE_ICONS[i % RELEVANCE_ICONS.length]} size={34} class="point__icon" />
                <span>
                  {p.title && <strong class="point__title">{p.title}</strong>}
                  <span class="point__text">{p.text}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    d.questions.length > 0 && (
      <section class:list={['section', bandClass(bg.questions)]} id="questions">
        <div class="container">
          <div class="section-head">
            <h2>Questions the work addresses.</h2>
          </div>
          <ul class="question-grid" role="list">
            {d.questions.map((q) => (
              <li class="question">
                <Icon name="question" size={38} class="question__icon" />
                <span>{q}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    (d.includes.length > 0 || d.exclusions.length > 0) && (
      <section class:list={['section', bandClass(bg.included)]} id="included">
        <div class="container">
          {d.includes.length > 0 && (
            <>
              <div class="section-head">
                <h2>What an engagement may include.</h2>
                <p class="lead">The proposal for each engagement sets out exactly which of these apply.</p>
              </div>
              <ul class="include-grid" role="list">
                {d.includes.map(asPoint).map((p, i) => (
                  <li class="include">
                    <Icon name={INCLUDE_ICONS[i % INCLUDE_ICONS.length]} size={40} class="include__icon" />
                    <span>
                      {p.title && <strong class="include__title">{p.title}</strong>}
                      <span class="include__text">{p.text}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </>
          )}
          <div class="scope">
            <Icon name="document" size={48} class="scope__icon" />
            <div>
              <h3 class="scope__title">The proposal defines what is included.</h3>
              <p>Each engagement is based on a clearly defined scope of work. Additional work requires a separate agreement.</p>
              {d.exclusions.length > 0 && (
                <>
                  <p class="scope__label">Not included unless agreed separately:</p>
                  <ul>
                    {d.exclusions.map((x) => (
                      <li>{x}</li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class:list={['section', bandClass(bg.begin)]} id="begin">
    <div class="container">
      <div class="section-head">
        <h2>How to begin.</h2>
        <p class="lead">A request is not an appointment. Paid work begins only after the scope and fee are agreed.</p>
      </div>
      <ol class="begin" role="list">
        {
          steps.map((step, i) => (
            <li class="begin__step">
              <span class="begin__num" aria-hidden="true">{i + 1}</span>
              <span>
                <strong class="begin__title">{step.title}</strong>
                <span class="begin__text">{step.text}</span>
              </span>
              {i < steps.length - 1 && <Icon name="arrow" size={18} class="begin__arrow" />}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class:list={['section', bandClass(bg.learning)]} id="learning">
        <div class="container two-col">
          <div>
            <h2>Related learning.</h2>
            <p class="lead">Educational resources on related topics.</p>
          </div>
          <ul class="point-list" role="list">
            {related.map((r) => (
              <li class="point">
                <Icon name="book" size={34} class="point__icon" />
                <span>
                  <a class="point__title" href={`/learn/${r!.id}`}>{r!.data.title}</a>
                  <span class="point__text">{r!.data.description}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    d.faqs.length > 0 && (
      <section class:list={['section', bandClass(bg.faqs)]} id="faqs">
        <div class="container">
          <div class="section-head">
            <h2>Frequently asked questions.</h2>
            <p class="lead">Common questions about this service and process.</p>
          </div>
          <div class="faqs">
            {d.faqs.map((f) => (
              <details>
                <summary>
                  {f.question}
                  <Icon name="chevron" size={18} class="faqs__chevron" />
                </summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    heading="Discuss this service with the team."
    copy="Share the decision in front of you and what is already in place. We will review it and identify the appropriate next step."
    href={startHref}
    label="Discuss This Service"
    layout="split"
    tone="teal"
  />
</Base>

<script>
  // Highlight the tab for the section currently on screen.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.tabs a')];
  const targets = links.map((a) => document.getElementById(a.hash.slice(1))).filter((el): el is HTMLElement => Boolean(el));
  const setActive = (id: string) => links.forEach((a) => (a.hash === `#${id}` ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
  const observer = new IntersectionObserver(
    (entries) => {
      const visibleEntry = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (visibleEntry) setActive(visibleEntry.target.id);
    },
    { rootMargin: '-80px 0px -60% 0px' },
  );
  targets.forEach((t) => observer.observe(t));
</script>

<style>
  /* Hero extras */
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.85rem; margin-bottom: 20px; color: var(--mist); }
  .crumbs a { color: #fff !important; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .engage { background: rgba(0, 46, 46, 0.94); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: var(--radius); padding: 24px; box-shadow: 0 18px 40px rgba(0, 0, 0, 0.3); }
  .engage__title { font-size: 1.4rem; color: #fff; margin-bottom: 8px; }
  .engage__list { list-style: none; margin: 0; padding: 0; }
  .engage__list li { display: flex; gap: 16px; align-items: flex-start; padding: 16px 0; border-top: 1px solid rgba(255, 255, 255, 0.14); margin: 0; color: #fff; }
  .engage__list li:first-child { border-top: 0; }
  .engage__list strong { display: block; font-size: 0.98rem; }
  .engage__list span { font-size: 0.85rem; color: var(--mist); line-height: 1.45; }
  .engage__list strong { color: #fff; }
  .engage :global(svg) { flex: none; color: #fff; }

  /* In-page tabs */
  .tabs { position: sticky; top: var(--header-h); z-index: 10; background: #fff; border-bottom: 1px solid var(--line); }
  .tabs ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 8px 36px; overflow-x: auto; scrollbar-width: none; }
  .tabs li + li { margin-top: 0; }
  .tabs a { display: block; padding: 18px 0 16px; color: var(--ink); text-decoration: none; font-size: 0.95rem; font-weight: 500; white-space: nowrap; border-bottom: 3px solid transparent; }
  .tabs a:hover { color: var(--teal); }
  .tabs a[aria-current='true'] { border-bottom-color: var(--gold); }
  .anchor { display: block; position: relative; top: -70px; }
  section[id] { scroll-margin-top: 64px; }

  /* Shared */
  .two-col { display: grid; gap: 32px 64px; align-items: start; }
  @media (min-width: 900px) {
    .two-col { grid-template-columns: 1fr 1fr; }
  }
  .two-col h2, .section-head h2 { font-size: clamp(1.9rem, 3.4vw, 2.6rem); }

  /* Relevance and related learning */
  .point-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .point-list li + li { margin-top: 0; }
  .point { display: flex; gap: 20px; align-items: flex-start; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 24px; }
  .point :global(.point__icon) { flex: none; color: var(--teal); margin-top: 2px; }
  .point__title { display: block; font-family: var(--font-heading); font-weight: 700; font-size: 1.1rem; color: var(--ink); margin-bottom: 2px; text-decoration: none; }
  a.point__title:hover { text-decoration: underline; }
  .point__text { display: block; color: var(--slate); font-size: 0.97rem; line-height: 1.5; }

  /* Questions */
  .question-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 800px) {
    .question-grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  }
  .question-grid li + li { margin-top: 0; }
  .question { display: flex; gap: 18px; align-items: center; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 22px 24px; font-family: var(--font-heading); font-size: 1.1rem; line-height: 1.35; }
  .question :global(.question__icon) { flex: none; color: var(--teal); }

  /* Includes and scope */
  .include-grid { list-style: none; margin: 0 0 20px; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 800px) {
    .include-grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  }
  .include-grid li + li { margin-top: 0; }
  .include { display: flex; gap: 18px; align-items: flex-start; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .include :global(.include__icon) { flex: none; color: var(--teal); }
  .include__title { display: block; font-family: var(--font-heading); font-weight: 700; font-size: 1.25rem; margin-bottom: 4px; }
  .include__text { display: block; color: var(--slate); font-size: 0.95rem; line-height: 1.5; }
  .scope { display: flex; gap: 28px; align-items: flex-start; background: var(--teal); color: #fff; border-radius: var(--radius); padding: 28px 32px; }
  .scope :global(.scope__icon) { flex: none; color: #fff; margin-top: 4px; }
  .scope__title { font-family: var(--font-heading); font-weight: 700; font-size: clamp(1.4rem, 2.6vw, 1.9rem); color: #fff; margin-bottom: 6px; }
  .scope p { color: #d9e6e5; margin-bottom: 8px; }
  .scope__label { font-weight: 500; color: #fff !important; margin-top: 12px; }
  .scope ul { margin: 0; color: #e3eeed; }
  @media (max-width: 600px) {
    .scope { flex-direction: column; gap: 12px; padding: 24px; }
  }

  /* How to begin */
  .begin { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; }
  @media (min-width: 900px) {
    .begin { grid-template-columns: repeat(3, 1fr); gap: 48px; }
  }
  .begin li + li { margin-top: 0; }
  .begin__step { position: relative; display: flex; gap: 18px; align-items: flex-start; }
  .begin__num { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: #dde9e6; color: var(--teal-deep); font-weight: 700; }
  .begin__title { display: block; font-family: var(--font-heading); font-weight: 700; font-size: 1.15rem; margin-bottom: 2px; }
  .begin__text { display: block; color: var(--slate); font-size: 0.95rem; line-height: 1.5; }
  .begin__step :global(.begin__arrow) { display: none; }
  @media (min-width: 900px) {
    .begin__step :global(.begin__arrow) { display: block; position: absolute; right: -34px; top: 12px; color: var(--slate); }
  }

  /* FAQs */
  .faqs details { border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .faqs details + details { margin-top: 10px; }
  .faqs summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 20px; cursor: pointer; font-weight: 500; list-style: none; }
  .faqs summary::-webkit-details-marker { display: none; }
  .faqs :global(.faqs__chevron) { flex: none; transform: rotate(90deg); transition: transform 0.15s ease; color: var(--teal); }
  .faqs details[open] :global(.faqs__chevron) { transform: rotate(-90deg); }
  .faqs details p { padding: 0 20px 18px; margin: 0; color: var(--slate); }
</style>

---
import { getEntries } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import DraftFlag from '../../components/DraftFlag.astro';
import { CATEGORIES } from '../../data/categories';
import { visible, formatPrice, SHOW_DRAFTS } from '../../lib/content';

export async function getStaticPaths() {
  const services = await visible('services');
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const d = service.data;
const startHref = `/start?service=${service.id}`;
const related = (await getEntries(d.relatedLearning)).filter((r) => r && (SHOW_DRAFTS || r.data.publication === 'published'));

const defaultSteps = [
  'Share your objective, the general situation, and any deadline through the request form.',
  'The team reviews the request and determines whether more detail, a paid consultation, an assessment, or a defined project is appropriate.',
  'Any proposed engagement identifies the responsible provider, deliverables, exclusions, and fee before paid work begins.',
];
const steps = d.howToBegin ?? defaultSteps;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: d.name,
    description: d.summary,
    provider: { '@type': 'Organization', name: 'IRA Ideas', url: Astro.site?.href },
  },
  d.faqs.length > 0 && {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  },
].filter(Boolean) as Record<string, unknown>[];
---

<Base title={d.name} description={`${d.subtitle}. ${d.summary}`} noindex={d.publication !== 'published'} jsonLd={jsonLd}>
  <section class="service-hero theme-dark">
    <div class="container">
      <nav aria-label="Breadcrumb" class="crumbs small"><a href="/advanced-services">Advanced Services</a> <span aria-hidden="true">/</span> {CATEGORIES[d.category].label}</nav>
      <DraftFlag state={d.publication} />
      <h1>{d.name}</h1>
      <p class="service-hero__subtitle">{d.subtitle}</p>
      <p class="lead">{d.summary}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={startHref}>Discuss This Service</a>
      </div>
    </div>
  </section>

  <div class="container service-body">
    <div class="service-main">
      {
        d.relevance.length > 0 && (
          <section>
            <h2>When this may be relevant</h2>
            <ul class="checklist">{d.relevance.map((x) => <li>{x}</li>)}</ul>
          </section>
        )
      }
      {
        d.questions.length > 0 && (
          <section>
            <h2>Questions the work addresses</h2>
            <ul>{d.questions.map((x) => <li>{x}</li>)}</ul>
          </section>
        )
      }
      {
        d.includes.length > 0 && (
          <section>
            <h2>What an engagement may include</h2>
            <ul class="checklist">{d.includes.map((x) => <li>{x}</li>)}</ul>
          </section>
        )
      }
      {
        d.exclusions.length > 0 && (
          <section>
            <h2>Scope boundaries</h2>
            <p class="muted">The following are not included unless agreed separately in writing.</p>
            <ul>{d.exclusions.map((x) => <li>{x}</li>)}</ul>
          </section>
        )
      }
      <section>
        <h2>How to begin</h2>
        <ol class="steps">{steps.map((x) => <li>{x}</li>)}</ol>
        <p class="muted small">A request is not an appointment. Any paid work begins only after the proposed scope and fee are agreed.</p>
      </section>
      {
        related.length > 0 && (
          <section>
            <h2>Related learning</h2>
            <ul>
              {related.map((r) => (
                <li>
                  <a href={`/learn/${r!.id}`}>{r!.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        d.faqs.length > 0 && (
          <section>
            <h2>Frequently asked questions</h2>
            <div class="faqs">
              {d.faqs.map((f) => (
                <details>
                  <summary>{f.question}</summary>
                  <p>{f.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }
    </div>
    <aside class="service-aside">
      <div class="card">
        <h3>Discuss this service</h3>
        <p class="small">Tell the team what you are trying to accomplish. You can change the selected service on the form.</p>
        {d.fee.display !== 'none' && d.fee.amount != null && (
          <p class="small"><strong>{d.fee.display === 'starting' ? 'Starting at' : 'Fee'}: {formatPrice(d.fee.amount)}</strong>{d.fee.note && <><br />{d.fee.note}</>}</p>
        )}
        <a class="btn btn--primary" href={startHref}>Discuss This Service</a>
      </div>
    </aside>
  </div>

  <CtaBand heading="Discuss this service with the team." copy="Share the decision in front of you and what is already in place. We will review it and identify the appropriate next step." href={startHref} label="Discuss This Service" />
</Base>

<style>
  .service-hero { padding: clamp(48px, 7vw, 88px) 0; }
  .service-hero h1, .service-hero .lead { max-width: 820px; }
  .service-hero__subtitle { color: var(--gold); font-size: 1.2rem; font-weight: 500; }
  .crumbs { margin-bottom: 24px; color: var(--gray-on-dark); }
  .service-body { display: grid; gap: 48px; padding-top: var(--space-section); padding-bottom: var(--space-section); }
  @media (min-width: 1000px) {
    .service-body { grid-template-columns: minmax(0, 1fr) 320px; gap: 72px; }
    .service-aside .card { position: sticky; top: 24px; }
  }
  .service-main { max-width: var(--reading); }
  .service-main section + section { margin-top: 56px; }
  .steps li { padding-left: 4px; }
  .faqs details { border-top: 1px solid var(--stone); padding: 16px 0; }
  .faqs details:last-child { border-bottom: 1px solid var(--stone); }
  .faqs summary { cursor: pointer; font-weight: 500; min-height: 32px; }
  .faqs details p { margin: 12px 0 0; }
</style>

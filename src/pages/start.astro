---
import Base from '../layouts/Base.astro';
import Turnstile from '../components/Turnstile.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES, CATEGORY_SLUGS } from '../data/categories';
import { visible } from '../lib/content';

const services = (await visible('services')).sort((a, b) => a.data.name.localeCompare(b.data.name));

const STATES = [
  'Alabama', 'Alaska', 'Arizona', 'Arkansas', 'California', 'Colorado', 'Connecticut', 'Delaware', 'District of Columbia', 'Florida',
  'Georgia', 'Hawaii', 'Idaho', 'Illinois', 'Indiana', 'Iowa', 'Kansas', 'Kentucky', 'Louisiana', 'Maine', 'Maryland', 'Massachusetts',
  'Michigan', 'Minnesota', 'Mississippi', 'Missouri', 'Montana', 'Nebraska', 'Nevada', 'New Hampshire', 'New Jersey', 'New Mexico',
  'New York', 'North Carolina', 'North Dakota', 'Ohio', 'Oklahoma', 'Oregon', 'Pennsylvania', 'Rhode Island', 'South Carolina',
  'South Dakota', 'Tennessee', 'Texas', 'Utah', 'Vermont', 'Virginia', 'Washington', 'West Virginia', 'Wisconsin', 'Wyoming',
];
---

<Base
  title="Discuss My Situation"
  description="Tell the IRA Ideas team about the decision, transaction, or concern you would like reviewed. You do not need to know which service applies."
>
  <section class="start-hero theme-dark">
    <div class="container">
      <p class="start-hero__eyebrow">Discuss My Situation</p>
      <h1>Tell us what you are working on.</h1>
      <p class="start-hero__lead">Share the decision, transaction, or concern you would like reviewed. You do not need to know which service applies.</p>
    </div>
  </section>

  <section class="start-body theme-light">
    <div class="container start-grid">
      <form id="inquiry-form" class="inquiry" action="/api/inquiry" method="post">
        <div class="stepper" data-stepper hidden>
          <p class="stepper__count" aria-live="polite" data-step-label>Step 1 of 2</p>
          <ol aria-label="Form progress">
            <li data-stepper-item="0"><span class="stepper__dot" aria-hidden="true"><span>1</span><Icon name="tick" size={16} /></span><span class="stepper__name">Your details</span></li>
            <li data-stepper-item="1"><span class="stepper__dot" aria-hidden="true"><span>2</span><Icon name="tick" size={16} /></span><span class="stepper__name">Your situation</span></li>
          </ol>
          <div class="stepper__bar" aria-hidden="true"><span data-step-bar></span></div>
        </div>

        <div class="form-alert" role="alert" tabindex="-1" hidden></div>

        <!-- Step 1: contact details -->
        <fieldset class="step" data-step="0">
          <legend class="step__legend">Your details</legend>
          <p class="step__intro">How the team can reach you about your request.</p>

          <div class="field-row">
            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" />
              <p class="field-error" data-error-for="name"></p>
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
              <p class="field-error" data-error-for="email"></p>
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="region">State or country</label>
              <select id="region" name="region" required>
                <option value="">Select your state or country</option>
                {STATES.map((s) => <option value={s}>{s}</option>)}
                <option value="Outside the United States">Outside the United States</option>
              </select>
              <p class="field-error" data-error-for="region"></p>
            </div>
            <div class="field">
              <label for="phone">Phone <span class="optional" data-phone-optional>(optional)</span></label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
              <p class="field-error" data-error-for="phone"></p>
            </div>
          </div>

          <fieldset class="field">
            <legend>I am contacting you for</legend>
            <div class="tiles tiles--3">
              <label class="tile"><input type="radio" name="contacting_for" value="myself" required /><span>Myself</span></label>
              <label class="tile"><input type="radio" name="contacting_for" value="business" /><span>My business</span></label>
              <label class="tile"><input type="radio" name="contacting_for" value="client" /><span>A client</span></label>
            </div>
            <p class="field-error" data-error-for="contacting_for"></p>
          </fieldset>
          <fieldset class="field">
            <legend>Preferred response</legend>
            <div class="tiles tiles--2">
              <label class="tile"><input type="radio" name="preferred_response" value="email" required checked /><span>Email</span></label>
              <label class="tile"><input type="radio" name="preferred_response" value="phone" /><span>Phone</span></label>
            </div>
            <p class="field-error" data-error-for="preferred_response"></p>
          </fieldset>

          <div class="actions" data-js-only hidden>
            <button type="button" class="btn btn--primary" data-next>Continue <Icon name="arrow" size={18} /></button>
          </div>
        </fieldset>

        <!-- Summary of step 1, shown while on step 2 -->
        <div class="summary" data-summary hidden>
          <div class="summary__head">
            <span class="summary__check" aria-hidden="true"><Icon name="tick" size={16} /></span>
            <h2>Your details</h2>
            <button type="button" class="summary__edit" data-edit>Edit</button>
          </div>
          <dl class="summary__grid">
            <div><dt>Name</dt><dd data-show="name"></dd></div>
            <div><dt>Email</dt><dd data-show="email"></dd></div>
            <div><dt>Contacting you for</dt><dd data-show="contacting_for"></dd></div>
            <div><dt>State or country</dt><dd data-show="region"></dd></div>
            <div><dt>Preferred response</dt><dd data-show="preferred_response"></dd></div>
            <div><dt>Phone</dt><dd data-show="phone"></dd></div>
          </dl>
        </div>

        <!-- Step 2: the situation -->
        <fieldset class="step" data-step="1">
          <legend class="step__legend">Your situation</legend>
          <p class="step__intro">A short overview is enough. Please do not include account numbers or confidential details.</p>

          <div class="field">
            <label for="subject">Service or subject</label>
            <select id="subject" name="subject" required>
              <option value="not-sure">Not sure</option>
              {
                services.length > 0 && (
                  <optgroup label="Services">
                    {services.map((s) => (
                      <option value={s.id}>{s.data.name}</option>
                    ))}
                  </optgroup>
                )
              }
              <optgroup label="General subjects">
                {CATEGORY_SLUGS.map((c) => <option value={c}>{CATEGORIES[c].label}</option>)}
              </optgroup>
            </select>
            <p class="field-error" data-error-for="subject"></p>
          </div>

          <div class="field">
            <label for="goal">What are you trying to accomplish?</label>
            <textarea id="goal" name="goal" required maxlength="600" rows="4" placeholder="For example, the decision you are weighing or the question you need answered."></textarea>
            <p class="field-error" data-error-for="goal"></p>
          </div>

          <div class="field">
            <label for="in_place">What is already in place? <span class="optional">(optional)</span></label>
            <textarea id="in_place" name="in_place" maxlength="600" rows="3" placeholder="For example, the general type of account, trust, or arrangement involved."></textarea>
            <p class="field-error" data-error-for="in_place"></p>
          </div>

          <fieldset class="field">
            <legend>Timing</legend>
            <div class="tiles tiles--3">
              <label class="tile"><input type="radio" name="timing" value="exploring" required /><span>Exploring options</span></label>
              <label class="tile"><input type="radio" name="timing" value="upcoming" /><span>Upcoming decision</span></label>
              <label class="tile"><input type="radio" name="timing" value="deadline" /><span>Specific deadline</span></label>
            </div>
            <p class="field-error" data-error-for="timing"></p>
          </fieldset>

          <div class="field-row">
            <div class="field" data-deadline>
              <label for="deadline">Deadline date</label>
              <input id="deadline" name="deadline" type="date" />
              <p class="field-error" data-error-for="deadline"></p>
            </div>
            <div class="field">
              <label for="amount_range">Approximate amount involved <span class="optional">(optional)</span></label>
              <select id="amount_range" name="amount_range">
                <option value="">Select a range</option>
                <option value="under-250k">Under $250,000</option>
                <option value="250k-1m">$250,000 to $1 million</option>
                <option value="1m-5m">$1 million to $5 million</option>
                <option value="over-5m">Over $5 million</option>
                <option value="prefer-not">Prefer not to say</option>
              </select>
            </div>
          </div>

          <fieldset class="field optins">
            <legend>Optional updates <span class="optional">(separate from your request)</span></legend>
            <div class="optins__box">
              <label class="choice"><input type="checkbox" name="marketing_email_optin" /> Send me occasional IRA Ideas emails with educational content and event information.</label>
              <label class="choice"><input type="checkbox" name="sms_optin" /> Send me occasional IRA Ideas text messages. Message and data rates may apply.</label>
            </div>
          </fieldset>

          <Turnstile />

          <p class="notice">
            Submitting a request does not establish an attorney-client relationship. Please do not include confidential documents or sensitive
            account information. The team will provide instructions if additional information is needed.
          </p>

          <div class="actions actions--split">
            <button type="button" class="back" data-back data-js-only hidden><Icon name="arrow" size={18} /> Back</button>
            <button type="submit" class="btn btn--primary">Send My Request <Icon name="arrow" size={18} /></button>
          </div>
        </fieldset>
      </form>

      <aside class="side">
        <div class="side__card">
          <h2>What happens next</h2>
          <ol role="list">
            <li><span aria-hidden="true">1</span><div><strong>Review</strong>Our team reviews your request.</div></li>
            <li><span aria-hidden="true">2</span><div><strong>Next step</strong>We contact you about the appropriate next step.</div></li>
            <li><span aria-hidden="true">3</span><div><strong>Defined scope</strong>Any paid work has a defined scope and fee before it begins.</div></li>
          </ol>
        </div>
        <div class="side__card side__card--note">
          <Icon name="calendar" size={28} />
          <p><strong>A request is not an appointment.</strong> Approved paid appointments are scheduled privately. <a href="/how-we-work">See how we work</a>.</p>
        </div>
        <div class="side__authority">
          <img src="/images/tim/tim-berry-shirt-400.webp" width="400" height="476" alt="" aria-hidden="true" loading="lazy" decoding="async" />
          <p>Built on nearly 30 years of retirement-plan experience with attorney Tim Berry.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  import { enhanceForm } from '../lib/forms';

  const form = document.getElementById('inquiry-form') as HTMLFormElement;
  const subject = form.querySelector<HTMLSelectElement>('#subject')!;
  const steps = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
  const stepper = form.querySelector<HTMLElement>('[data-stepper]')!;
  const label = form.querySelector<HTMLElement>('[data-step-label]')!;
  const bar = form.querySelector<HTMLElement>('[data-step-bar]')!;
  const summary = form.querySelector<HTMLElement>('[data-summary]')!;
  const deadlineField = form.querySelector<HTMLElement>('[data-deadline]')!;
  const deadline = form.querySelector<HTMLInputElement>('#deadline')!;
  const phone = form.querySelector<HTMLInputElement>('#phone')!;
  const phoneOptional = form.querySelector<HTMLElement>('[data-phone-optional]')!;

  // Preselect the service or subject from the link, while leaving it changeable.
  const params = new URLSearchParams(location.search);
  const wanted = params.get('service') || params.get('subject');
  // The private intensive is unlisted, so its option only appears when linked from its page.
  if (wanted === 'private-strategy-intensive') subject.add(new Option('Private Strategy Intensive', wanted), 1);
  if (wanted && [...subject.options].some((o) => o.value === wanted)) subject.value = wanted;

  // Fill the step 1 summary from the entered values.
  const LABELS: Record<string, Record<string, string>> = {
    contacting_for: { myself: 'Myself', business: 'My business', client: 'A client' },
    preferred_response: { email: 'Email', phone: 'Phone' },
  };
  const fillSummary = () => {
    const data = new FormData(form);
    summary.querySelectorAll<HTMLElement>('[data-show]').forEach((dd) => {
      const key = dd.dataset.show!;
      const raw = String(data.get(key) ?? '').trim();
      dd.textContent = (LABELS[key]?.[raw] ?? raw) || 'Not provided';
    });
  };

  // Two steps with a visible indicator. Without JavaScript, both steps show.
  const titles = ['Your details', 'Your situation'];
  let current = 0;
  const show = (i: number, focus = true) => {
    current = i;
    steps.forEach((s, n) => (s.hidden = n !== i));
    summary.hidden = i !== 1;
    if (i === 1) fillSummary();
    stepper.querySelectorAll<HTMLElement>('[data-stepper-item]').forEach((li) => {
      const n = Number(li.dataset.stepperItem);
      li.classList.toggle('is-done', n < i);
      li.classList.toggle('is-current', n === i);
      if (n === i) li.setAttribute('aria-current', 'step');
      else li.removeAttribute('aria-current');
    });
    label.textContent = `Step ${i + 1} of 2: ${titles[i]}`;
    bar.style.width = i === 0 ? '50%' : '100%';
    if (focus) {
      stepper.scrollIntoView({ block: 'start', behavior: 'smooth' });
      steps[i].querySelector<HTMLElement>('input:not([type=hidden]), select, textarea')?.focus({ preventScroll: true });
    }
  };
  form.querySelectorAll<HTMLElement>('[data-js-only]').forEach((el) => (el.hidden = false));
  stepper.hidden = false;
  show(0, false);

  const validStep = (i: number) => {
    for (const el of steps[i].querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')) {
      if (!el.checkValidity()) {
        el.reportValidity();
        return false;
      }
    }
    return true;
  };
  form.querySelector('[data-next]')!.addEventListener('click', () => validStep(0) && show(1));
  form.querySelector('[data-back]')!.addEventListener('click', () => show(0));
  form.querySelector('[data-edit]')!.addEventListener('click', () => show(0));

  // Server errors: return to whichever step holds the first problem field.
  form.addEventListener('form:errors', (e) => {
    const first = (e as CustomEvent).detail.first as HTMLElement | null;
    const idx = first ? steps.findIndex((s) => s.contains(first)) : -1;
    if (idx >= 0 && idx !== current) show(idx, false);
  });

  // Conditional fields.
  const syncTiming = () => {
    const isDeadline = (form.querySelector('input[name=timing]:checked') as HTMLInputElement | null)?.value === 'deadline';
    deadlineField.hidden = !isDeadline;
    deadline.required = isDeadline;
  };
  const syncPhone = () => {
    const wantsPhone = (form.querySelector('input[name=preferred_response]:checked') as HTMLInputElement | null)?.value === 'phone';
    const wantsSms = (form.querySelector('input[name=sms_optin]') as HTMLInputElement).checked;
    phone.required = wantsPhone || wantsSms;
    phoneOptional.hidden = phone.required;
  };
  form.addEventListener('change', () => {
    syncTiming();
    syncPhone();
  });
  syncTiming();
  syncPhone();

  enhanceForm(form, {
    startEvent: 'service_inquiry_started',
    successEvent: 'service_inquiry_submitted',
    eventProps: () => ({ service: subject.value }),
  });
</script>

<style>
  /* Hero */
  .start-hero { background: linear-gradient(160deg, #0f504e 0%, var(--teal) 55%, var(--teal-deep) 100%); padding: clamp(40px, 5vw, 64px) 0 clamp(88px, 9vw, 120px); }
  .start-hero__eyebrow { display: flex; align-items: center; gap: 16px; font-size: 0.8rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: #fff; margin-bottom: 14px; }
  .start-hero__eyebrow::after { content: ''; width: 56px; height: 1px; background: rgba(255, 255, 255, 0.6); }
  .start-hero h1 { color: #fff; font-size: clamp(2.2rem, 4.6vw, 3.4rem); max-width: 760px; margin-bottom: 12px; }
  .start-hero__lead { color: #e3eeed; font-size: 1.12rem; max-width: 640px; margin: 0; }

  /* Layout: form card overlaps the hero */
  .start-body { padding-bottom: clamp(48px, 6vw, 88px); }
  .start-grid { display: grid; gap: 24px; align-items: start; margin-top: -64px; }
  @media (min-width: 1000px) {
    .start-grid { grid-template-columns: minmax(0, 1fr) 360px; gap: 32px; }
    .side { position: sticky; top: var(--sticky-top); margin-top: 64px; }
  }

  .inquiry { position: relative; background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: clamp(22px, 4vw, 44px); box-shadow: 0 18px 48px rgba(11, 27, 35, 0.1); }

  /* Progress */
  .stepper { margin-bottom: 32px; scroll-margin-top: 16px; }
  .stepper[hidden] { display: none; }
  .stepper__count { font-size: 0.82rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--slate); margin-bottom: 12px; }
  .stepper ol { list-style: none; margin: 0 0 14px; padding: 0; display: flex; gap: 28px; }
  .stepper li { display: flex; align-items: center; gap: 10px; margin: 0; color: var(--slate); font-weight: 500; }
  .stepper__dot { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; border: 1.5px solid #b8c2c0; font-size: 0.85rem; font-weight: 700; color: var(--slate); }
  .stepper__dot :global(svg) { display: none; }
  .is-current { color: var(--ink) !important; }
  .is-current .stepper__dot { background: var(--teal-deep); border-color: var(--teal-deep); color: #fff; }
  .is-done .stepper__dot { background: #e3eeec; border-color: var(--teal); color: var(--teal); }
  .is-done .stepper__dot > span { display: none; }
  .is-done .stepper__dot :global(svg) { display: block; }
  .stepper__bar { height: 4px; border-radius: 4px; background: var(--line); overflow: hidden; }
  .stepper__bar span { display: block; height: 100%; width: 50%; background: var(--gold); transition: width 0.25s ease; }

  /* Steps */
  .step[hidden] { display: none; }
  .step__legend { font-family: var(--font-heading); font-weight: 700; font-size: clamp(1.7rem, 3vw, 2.1rem); padding: 0; margin-bottom: 4px; }
  .step__intro { color: var(--slate); margin-bottom: 28px; }
  .field-row { display: grid; gap: 0 20px; }
  @media (min-width: 640px) {
    .field-row { grid-template-columns: 1fr 1fr; }
  }
  .field label, .field legend { font-size: 0.95rem; }
  [data-deadline][hidden] { display: none; }

  /* Option tiles (styled radio buttons) */
  .tiles { display: grid; gap: 10px; }
  @media (min-width: 560px) {
    .tiles--3 { grid-template-columns: repeat(3, 1fr); }
    .tiles--2 { grid-template-columns: repeat(2, 1fr); max-width: 66%; }
  }
  .tile { position: relative; display: flex !important; align-items: center; gap: 12px; min-height: 52px; padding: 12px 16px; margin: 0 !important; border: 1px solid #b8c2c0; border-radius: var(--radius); background: #fff; cursor: pointer; font-weight: 400 !important; transition: border-color 0.15s ease, background-color 0.15s ease; }
  .tile:hover { border-color: var(--teal); }
  .tile input { width: 18px; height: 18px; margin: 0; flex: none; accent-color: var(--teal-deep); }
  .tile:has(input:checked) { border-color: var(--teal-deep); background: #eef5f3; box-shadow: inset 0 0 0 1px var(--teal-deep); font-weight: 500 !important; }
  .tile:has(input:focus-visible) { outline: 3px solid var(--gold); outline-offset: 2px; }

  .optins { margin-top: 4px; }
  .optins__box { padding: 14px 18px; background: var(--light); border-radius: var(--radius); }
  .optins legend { margin-bottom: 6px; padding: 0; }
  .notice { margin-top: 24px; }

  .actions { display: flex; justify-content: flex-end; margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--line); }
  .actions[hidden], [data-js-only][hidden] { display: none !important; }
  .actions--split { justify-content: space-between; align-items: center; }
  .actions .btn { min-width: 200px; }
  .back { display: inline-flex; align-items: center; gap: 8px; background: none; border: 0; padding: 10px 0; font: inherit; font-weight: 500; color: var(--teal); cursor: pointer; }
  .back:hover { text-decoration: underline; }
  .back :global(svg) { transform: rotate(180deg); }
  @media (max-width: 559px) {
    .actions { flex-direction: column-reverse; align-items: stretch; gap: 8px; }
    .actions .btn { width: 100%; }
    .back { justify-content: center; }
  }

  /* Summary */
  .summary { border: 1px solid var(--line); border-radius: var(--radius); margin-bottom: 32px; background: #fafbfb; }
  .summary[hidden] { display: none; }
  .summary__head { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line); }
  .summary__check { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: #e3eeec; color: var(--teal); }
  .summary__head h2 { flex: 1; font-family: var(--font-body); font-size: 1rem; font-weight: 700; margin: 0; }
  .summary__edit { background: none; border: 1px solid var(--line); border-radius: var(--radius); padding: 6px 14px; font: inherit; font-size: 0.9rem; font-weight: 500; color: var(--teal); cursor: pointer; }
  .summary__edit:hover { border-color: var(--teal); }
  .summary__grid { display: grid; gap: 12px 24px; margin: 0; padding: 16px 18px; }
  @media (min-width: 560px) {
    .summary__grid { grid-template-columns: repeat(3, 1fr); }
  }
  .summary__grid dt { font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--slate); }
  .summary__grid dd { margin: 2px 0 0; font-size: 0.95rem; overflow-wrap: anywhere; }

  /* Sidebar */
  .side { display: grid; gap: 16px; }
  .side__card { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 24px; }
  .side__card h2 { font-size: 1.4rem; margin-bottom: 16px; }
  .side__card ol { list-style: none; margin: 0; padding: 0; }
  .side__card li { position: relative; display: flex; gap: 14px; margin: 0; padding-bottom: 18px; }
  .side__card li:last-child { padding-bottom: 0; }
  .side__card li:not(:last-child)::before { content: ''; position: absolute; left: 14px; top: 32px; bottom: 4px; width: 1px; background: var(--line); }
  .side__card li > span { flex: none; display: grid; place-items: center; width: 29px; height: 29px; border-radius: 50%; background: #e3eeec; color: var(--teal-deep); font-weight: 700; font-size: 0.85rem; }
  .side__card li strong { display: block; font-size: 0.98rem; }
  .side__card li div { color: var(--slate); font-size: 0.92rem; line-height: 1.5; }
  .side__card--note { display: flex; gap: 14px; align-items: flex-start; background: #eef5f3; border-color: #cfe0dc; }
  .side__card--note :global(svg) { flex: none; color: var(--teal); }
  .side__card--note p { margin: 0; font-size: 0.92rem; color: var(--slate); }
  .side__card--note strong { color: var(--ink); }
  .side__authority { display: flex; gap: 14px; align-items: center; padding: 4px 6px; }
  .side__authority img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; object-position: 50% 6%; background: #dfe8e6; flex: none; }
  .side__authority p { margin: 0; font-size: 0.88rem; color: var(--slate); }
  @media (max-width: 999px) {
    .side__authority { display: none; }
  }
</style>

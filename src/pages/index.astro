---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES, CATEGORY_SLUGS } from '../data/categories';
import { site } from '../data/site';
import { visible, listedEvents, isUpcoming } from '../lib/content';
import { getEntry } from 'astro:content';

const services = await visible('services');
const SITUATION_ICONS = {
  'retirement-roth': 'piggy',
  'trusts-wealth-transfer': 'shield',
  'ownership-transactions': 'building',
  'plan-transaction-concerns': 'document',
} as const;
const countByCategory = Object.fromEntries(CATEGORY_SLUGS.map((c) => [c, services.filter((s) => s.data.category === c).length]));

const upcoming = (await listedEvents()).filter(isUpcoming);
const featured = upcoming.find((e) => e.data.featured) ?? upcoming[0];

const resources = (await visible('resources')).sort((a, b) => b.data.publishedDate.localeCompare(a.data.publishedDate)).slice(0, 3);
const resourceAuthors = await Promise.all(resources.map((r) => getEntry(r.data.author)));
const learningAvailable = resources.length > 0;

const proof = (await visible('testimonials')).filter((t) => t.data.placements.includes('home'));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.brand,
    description: site.descriptor,
    url: Astro.site?.href,
    founder: { '@type': 'Person', name: 'Tim Berry', jobTitle: 'Attorney', url: new URL('/about/tim-berry', Astro.site).href },
  },
];
---

<Base
  title="Home"
  description="Advanced planning for retirement accounts, trusts, ownership structures, and complex transactions, built on nearly 30 years of retirement-plan experience with attorney Tim Berry."
  jsonLd={jsonLd}
>
  <!-- 1. Hero -->
  <section class="hero theme-dark">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__eyebrow">Advanced Retirement &amp; Tax Strategies</p>
        <h1>Before your next major move, know your options.</h1>
        <p class="hero__lead">
          Advanced planning for retirement accounts, trusts, ownership structures, and complex transactions. Work with our team on your
          situation, join a focused planning event, or deepen your understanding through advanced education.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/start">Discuss My Situation</a>
          <a class="btn btn--secondary" href="/conferences">Explore Conferences</a>
        </div>
        <div class="hero__authority-row">
          <img
            class="hero__avatar"
            src="/images/tim/tim-berry-shirt-400.webp"
            width="400"
            height="476"
            alt=""
            aria-hidden="true"
            decoding="async"
          />
          <p class="hero__authority">{site.authority}</p>
        </div>
      </div>
      <div class="hero__visual">
        <img
          class="hero__photo"
          src="/images/tim/tim-berry-shirt-861.webp"
          srcset="/images/tim/tim-berry-shirt-400.webp 400w, /images/tim/tim-berry-shirt-600.webp 600w, /images/tim/tim-berry-shirt-861.webp 861w"
          sizes="(min-width: 1200px) 620px, (min-width: 900px) 50vw, 85vw"
          width="861"
          height="1024"
          alt="Tim Berry, attorney, in a striped shirt with arms crossed"
          fetchpriority="high"
        />
        <p class="hero__label">
          <span class="hero__label-name">Tim Berry</span>
          <span class="hero__label-role">Attorney</span>
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Three ways to work with IRA Ideas -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--center">
        <h2>Choose your next step.</h2>
        <p class="lead">Three ways to work with IRA Ideas.</p>
      </div>
      <div class="offerings">
        <article class="offering offering--primary">
          <Icon name="document" size={40} class="offering__icon" />
          <h3>Advanced Services</h3>
          <p>
            Bring us a significant planning decision, proposed transaction, or issue that needs a closer look. We will review the request
            and identify the appropriate next step.
          </p>
          <a class="btn btn--primary" href="/advanced-services">Explore Advanced Services <Icon name="arrow" size={18} /></a>
        </article>
        <article class="offering">
          <Icon name="people" size={40} class="offering__icon" />
          <h3>Conferences</h3>
          <p>Join focused events built around advanced concepts, practical discussion, and clearly defined learning or planning objectives.</p>
          <a class="btn btn--outline" href="/conferences">Explore Conferences <Icon name="arrow" size={18} /></a>
        </article>
        <article class="offering">
          <Icon name="book" size={40} class="offering__icon" />
          <h3>Advanced Learning</h3>
          <p>Build a deeper understanding of the strategies, structures, and questions behind important financial decisions.</p>
          {
            learningAvailable ? (
              <a class="btn btn--outline" href="/learn">
                Explore Learning <Icon name="arrow" size={18} />
              </a>
            ) : (
              <a class="btn btn--outline" href="/learn#learning-signup">
                Get Learning Updates <Icon name="arrow" size={18} />
              </a>
            )
          }
        </article>
      </div>

      <!-- 3. Situation-based entry points -->
      <div class="section-head section-head--center situations-head">
        <h2>What are you working through?</h2>
        <p class="lead">You do not need to know the name of the strategy. Start with the decision in front of you.</p>
      </div>
      <div class="situations">
        {
          CATEGORY_SLUGS.map((slug) => {
            const has = countByCategory[slug] > 0;
            return (
              <a class="situation" href={has ? `/advanced-services?category=${slug}#directory` : `/start?subject=${slug}`}>
                <Icon name={SITUATION_ICONS[slug]} size={44} class="situation__icon" />
                <span class="situation__text">
                  <span class="situation__title">{CATEGORIES[slug].label}</span>
                  <span class="situation__desc">{CATEGORIES[slug].description}</span>
                  <span class="visually-hidden">{has ? 'View related services' : 'Discuss this with the team'}</span>
                </span>
                <Icon name="chevron" size={22} class="situation__chevron" />
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- 4. Tim and the team -->
  <section class="section">
    <div class="container about">
      <div class="about__media">
        <img
          src="/images/tim/tim-berry-shirt-861.webp"
          srcset="/images/tim/tim-berry-shirt-600.webp 600w, /images/tim/tim-berry-shirt-861.webp 861w"
          sizes="(min-width: 900px) 560px, 90vw"
          width="861"
          height="1024"
          alt="Tim Berry, attorney"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="about__copy">
        <h2>Deep experience. A team to move the work forward.</h2>
        <p>IRA Ideas brings attorney Tim Berry's retirement-plan experience together with a coordinated approach to education and specialized services.</p>
        <p>Tim's expertise is central to the work. Our team helps organize the information, communication, and next steps around each engagement.</p>
        <a class="btn btn--primary" href="/about/tim-berry">Meet Tim Berry <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- 5. Experience through change -->
  <section class="experience theme-dark">
    <div class="container">
      <h2 class="experience__title">Advanced planning does not stand still.</h2>
      <p class="experience__copy">
        Retirement planning has evolved throughout the nearly 30 years behind our work. Our approach is to examine the rules, the
        structure, and the facts that matter to the decision in front of you.
      </p>
    </div>
  </section>

  <!-- 6. Proof: shown only when approved proof exists -->
  {
    proof.length > 0 && (
      <section class="section theme-light">
        <div class="container">
          <div class="section-head">
            <h2>See what thoughtful review looks like.</h2>
          </div>
          <div class="grid grid--2">
            {proof.map((t) => (
              <figure class="card proof">
                <blockquote>
                  <p>{t.data.quote}</p>
                </blockquote>
                <figcaption class="muted">{t.data.attribution}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 7. Featured conference -->
  <section class="section split-section">
    <div class="container split">
      <div class="split__copy">
        <h2>Go deeper in the room.</h2>
        <p class="lead">
          Explore IRA Ideas events designed for focused learning, meaningful discussion, and a clearer understanding of the questions that
          matter to you.
        </p>
        {
          featured ? (
            <div class="btn-row">
              <a class="btn btn--primary" href={`/conferences/${featured.id}`}>
                View Event Details <Icon name="arrow" size={18} />
              </a>
            </div>
          ) : (
            <>
              <p class="split__strong">Be first to hear about the next event.</p>
              <div class="btn-row">
                <a class="btn btn--primary" href="/conferences#priority-list">
                  Join the Priority List <Icon name="arrow" size={18} />
                </a>
              </div>
            </>
          )
        }
        <p class="split__aside">
          Have a planning need that cannot wait for an event? <a href="/start">Discuss My Situation <Icon name="chevron" size={16} /></a>
        </p>
      </div>
      <div class="split__media">
        {
          featured ? (
            <EventCard event={featured} />
          ) : (
            <div class="art art--conference" aria-hidden="true">
              <Icon name="people" size={120} />
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- 8. Learning preview -->
  {
    learningAvailable ? (
      <section class="section theme-light">
        <div class="container">
          <div class="section-head">
            <h2>Understand more before you decide.</h2>
          </div>
          <div class="grid grid--3">
            {resources.map((r, i) => (
              <article class="card">
                <p class="eyebrow">
                  {CATEGORIES[r.data.topic].label} &middot; {r.data.format}
                </p>
                <h3>
                  <a href={`/learn/${r.id}`}>{r.data.title}</a>
                </h3>
                <p class="muted small">
                  {resourceAuthors[i]?.data.name}
                  {r.data.duration && <> &middot; {r.data.duration}</>}
                </p>
              </article>
            ))}
          </div>
          <div class="btn-row learn-more">
            <a class="btn btn--primary" href="/learn">
              Explore Learning <Icon name="arrow" size={18} />
            </a>
          </div>
        </div>
      </section>
    ) : (
      <section class="section theme-light split-section">
        <div class="container split split--reverse">
          <div class="split__media">
            <div class="art art--learning" aria-hidden="true">
              <Icon name="book" size={120} />
            </div>
          </div>
          <div class="split__copy">
            <h2>Free advanced learning is on the way.</h2>
            <p class="lead">Join the IRA Ideas learning list for new educational resources and announcements as they are released.</p>
            <div class="btn-row">
              <a class="btn btn--primary" href="/learn#learning-signup">
                Get Learning Updates <Icon name="arrow" size={18} />
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- 9. Final action -->
  <CtaBand
    heading="Bring us the situation. We will help identify the next step."
    copy="Tell our team what you are considering, what is already in place, and any deadline. We will review the request and explain how the work could proceed."
    note="Any proposed paid work will have a defined scope and fee before it begins."
  />
</Base>

<style>
  /* Hero: angled bottom edge kept from the previous design */
  .hero {
    position: relative;
    padding: clamp(48px, 6vw, 72px) 0 0;
    background:
      radial-gradient(ellipse 45% 75% at 80% 45%, rgba(255, 255, 255, 0.08), transparent 70%),
      linear-gradient(160deg, #0f504e 0%, var(--teal) 55%, var(--teal-deep) 100%);
    clip-path: polygon(0 0, 100% 0, 100% 88%, 62% 100%, 0 93%);
    overflow: hidden;
  }
  .hero__grid { display: grid; gap: 24px; align-items: end; }
  @media (min-width: 900px) {
    .hero__grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  .hero__copy { padding-bottom: clamp(80px, 10vw, 150px); }
  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 20px;
  }
  .hero__eyebrow::after { content: ''; width: 56px; height: 1px; background: rgba(255, 255, 255, 0.6); }
  .hero h1 { font-size: clamp(2.5rem, 5.2vw, 4rem); color: #fff; letter-spacing: -0.02em; line-height: 1.05; }
  .hero__lead { color: #e3eeed; max-width: 560px; font-size: 1.1rem; margin-bottom: 28px; }
  .hero__authority-row { display: flex; align-items: center; gap: 14px; margin-top: 24px; }
  .hero__authority { margin: 0; color: #e3eeed; font-size: 0.95rem; }
  .hero__avatar {
    display: none;
    width: 64px;
    height: 64px;
    flex: none;
    object-fit: cover;
    object-position: 50% 6%;
    border-radius: 50%;
    border: 2px solid var(--gold);
    background: var(--teal-deep);
  }
  .hero__visual { position: relative; align-self: end; justify-self: end; width: 100%; max-width: 620px; }
  .hero__photo { width: 100%; height: auto; }
  .hero__label {
    position: absolute;
    top: 14%;
    right: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    color: #fff;
  }
  .hero__label::after { content: ''; width: 40px; height: 1px; background: rgba(255, 255, 255, 0.6); margin-top: 12px; }
  .hero__label-name { font-weight: 700; }
  .hero__label-role { font-size: 0.9rem; color: var(--mist); }
  @media (max-width: 899px) {
    .hero { clip-path: polygon(0 0, 100% 0, 100% 96%, 0 100%); }
    .hero__copy { padding-bottom: 8px; }
    .hero__avatar { display: block; }
    .hero__eyebrow::after { display: none; }
    .hero__visual { max-width: 420px; justify-self: center; }
    .hero__label { top: auto; bottom: 18%; right: 0; background: rgba(0, 58, 58, 0.85); padding: 10px 14px; border-radius: var(--radius); }
    .hero__label::after { display: none; }
  }

  /* Offerings */
  .offerings { display: grid; gap: 20px; }
  @media (min-width: 900px) {
    .offerings { grid-template-columns: repeat(3, 1fr); }
  }
  .offering {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 32px;
    box-shadow: 0 1px 2px rgba(11, 27, 35, 0.04);
  }
  .offering h3 { font-family: var(--font-heading); font-weight: 700; font-size: 1.55rem; margin: 18px 0 10px; }
  .offering p { color: var(--slate); flex: 1; }
  .offering :global(.offering__icon) { color: var(--teal); }
  .offering .btn { margin-top: 8px; width: 100%; }
  .offering--primary { background: var(--teal); border-color: var(--teal); color: #fff; box-shadow: 0 16px 36px rgba(12, 67, 66, 0.25); }
  .offering--primary p { color: #d9e6e5; }
  .offering--primary :global(.offering__icon) { color: #fff; }

  /* Situations */
  .situations-head { margin-top: clamp(64px, 8vw, 96px); }
  .situations { display: grid; gap: 16px; }
  @media (min-width: 800px) {
    .situations { grid-template-columns: 1fr 1fr; gap: 20px; }
  }
  .situation {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px 24px 24px 22px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .situation:hover { border-color: var(--teal); box-shadow: 0 10px 24px rgba(11, 27, 35, 0.08); color: var(--ink); }
  .situation :global(.situation__icon) { color: var(--teal); flex: none; }
  .situation__text { display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .situation__title { font-family: var(--font-heading); font-weight: 700; font-size: 1.15rem; }
  .situation__desc { color: var(--slate); font-size: 0.95rem; line-height: 1.5; }
  .situation :global(.situation__chevron) { color: var(--teal); flex: none; transition: transform 0.15s ease; }
  .situation:hover :global(.situation__chevron) { transform: translateX(3px); }

  /* About */
  .about { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) {
    .about { grid-template-columns: 1.1fr 1fr; gap: 64px; }
  }
  .about__media {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    background:
      radial-gradient(ellipse 60% 70% at 50% 35%, #ffffff 0%, transparent 70%),
      linear-gradient(160deg, #e8eeed 0%, #d5e1df 100%);
    box-shadow: 0 12px 32px rgba(11, 27, 35, 0.1);
  }
  .about__media img { width: 62%; height: auto; margin-bottom: -2%; }
  .about__copy h2 { font-size: clamp(1.9rem, 3.4vw, 2.6rem); }
  .about__copy p { color: var(--slate); }
  .about__copy .btn { margin-top: 8px; }

  /* Experience band */
  .experience { padding: clamp(40px, 5vw, 56px) 0; text-align: center; }
  .experience__title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    margin: 0 0 10px;
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
  }
  .experience__title::before, .experience__title::after { content: ''; flex: 0 0 80px; height: 1px; background: rgba(255, 255, 255, 0.45); }
  .experience__copy { max-width: 760px; margin: 0 auto; color: #e3eeed; }
  @media (max-width: 700px) {
    .experience__title::before, .experience__title::after { display: none; }
  }

  /* Split sections (conference, learning) */
  .split-section { padding: clamp(56px, 7vw, 88px) 0; }
  .split { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) {
    .split { grid-template-columns: 1fr 1fr; gap: 64px; }
    .split--reverse .split__media { order: -1; }
  }
  .split__copy h2 { font-size: clamp(1.9rem, 3.4vw, 2.6rem); }
  .split__strong { font-weight: 700; margin: 20px 0 16px; }
  .split__aside { margin: 24px 0 0; color: var(--slate); font-size: 0.95rem; }
  .split__aside a { font-weight: 500; color: var(--teal); white-space: nowrap; }
  .split__aside :global(svg) { vertical-align: -3px; }

  /* Illustration panels, used until real event or learning photos are supplied */
  .art {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.85);
    background:
      radial-gradient(circle at 25% 20%, rgba(255, 180, 0, 0.18), transparent 45%),
      radial-gradient(ellipse 70% 80% at 70% 80%, rgba(255, 255, 255, 0.08), transparent 70%),
      linear-gradient(150deg, #145856 0%, var(--teal) 50%, var(--teal-deep) 100%);
    box-shadow: 0 12px 32px rgba(11, 27, 35, 0.14);
  }
  .art--learning { background:
      radial-gradient(circle at 75% 25%, rgba(255, 180, 0, 0.18), transparent 45%),
      linear-gradient(150deg, var(--navy) 0%, #12313a 60%, var(--teal-deep) 100%); }

  .learn-more { margin-top: 32px; }
  .proof blockquote { margin: 0 0 16px; font-family: var(--font-heading); font-size: 1.2rem; }
</style>

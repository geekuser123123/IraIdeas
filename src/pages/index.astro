---
import Base from '../layouts/Base.astro';
import TimPhoto from '../components/TimPhoto.astro';
import EventCard from '../components/EventCard.astro';
import SignupForm from '../components/SignupForm.astro';
import CtaBand from '../components/CtaBand.astro';
import { CATEGORIES, CATEGORY_SLUGS } from '../data/categories';
import { site } from '../data/site';
import { visible, listedEvents, isUpcoming } from '../lib/content';
import { getEntry } from 'astro:content';

const services = await visible('services');
const countByCategory = Object.fromEntries(CATEGORY_SLUGS.map((c) => [c, services.filter((s) => s.data.category === c).length]));

const upcoming = (await listedEvents()).filter(isUpcoming);
const featured = upcoming.find((e) => e.data.featured) ?? upcoming[0];

const resources = (await visible('resources')).sort((a, b) => b.data.publishedDate.localeCompare(a.data.publishedDate)).slice(0, 3);
const resourceAuthors = await Promise.all(resources.map((r) => getEntry(r.data.author)));
const learningAvailable = resources.length > 0;

const proof = (await visible('testimonials')).filter((t) => t.data.placements.includes('home'));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.brand,
    description: site.descriptor,
    url: Astro.site?.href,
    founder: { '@type': 'Person', name: 'Tim Berry', jobTitle: 'Attorney', url: new URL('/about/tim-berry', Astro.site).href },
  },
];
---

<Base
  title="Home"
  description="Advanced planning for retirement accounts, trusts, ownership structures, and complex transactions, built on nearly 30 years of retirement-plan experience with attorney Tim Berry."
  jsonLd={jsonLd}
>
  <!-- 1. Hero -->
  <section class="hero theme-dark">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__eyebrow">Advanced Retirement &amp; Tax Strategies</p>
        <h1><span class="accent">Before your next major move,</span> know your options.</h1>
        <p class="hero__lead">
          Advanced planning for retirement accounts, trusts, ownership structures, and complex transactions. Work with our team on your
          situation, join a focused planning event, or deepen your understanding through advanced education.
        </p>
        <div class="hero__authority-row">
          <img
            class="hero__avatar"
            src="/images/tim/tim-berry-shirt-400.webp"
            width="400"
            height="476"
            alt=""
            aria-hidden="true"
            decoding="async"
          />
          <p class="hero__authority">{site.authority}</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/start">Discuss My Situation <span aria-hidden="true">&rarr;</span></a>
          <a class="btn btn--secondary" href="/conferences">Explore Conferences</a>
        </div>
      </div>
      <div class="hero__visual">
        <img
          class="hero__photo"
          src="/images/tim/tim-berry-shirt-600.webp"
          srcset="/images/tim/tim-berry-shirt-400.webp 400w, /images/tim/tim-berry-shirt-600.webp 600w, /images/tim/tim-berry-shirt-861.webp 861w"
          sizes="(min-width: 1024px) 460px, (min-width: 768px) 42vw, 80vw"
          width="861"
          height="1024"
          alt="Tim Berry, attorney, in a striped shirt with arms crossed"
          fetchpriority="high"
        />
        <div class="hero__nameplate">
          <p class="hero__name">Tim Berry</p>
          <p class="hero__role">Attorney</p>
          <p class="hero__years">Nearly 30 years of retirement-plan experience</p>
          <a href="/about/tim-berry" class="hero__meet">Meet Tim Berry <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Three ways to work with IRA Ideas -->
  <section class="section offerings-section theme-darker">
    <div class="container">
      <div class="section-head section-head--center">
        <h2>Choose your <span class="accent">next step.</span></h2>
        <hr class="rule" />
        <p class="muted">Three ways to work with IRA Ideas</p>
      </div>
      <div class="offerings">
        <article class="card card--light offering offering--primary">
          <p class="offering__badge">Primary offering</p>
          <h3 class="title-rule">Advanced Services</h3>
          <p>
            Bring us a significant planning decision, proposed transaction, or issue that needs a closer look. We will review the request
            and identify the appropriate next step.
          </p>
          <a class="btn btn--primary" href="/advanced-services">Explore Advanced Services <span aria-hidden="true">&rarr;</span></a>
        </article>
        <article class="card card--light offering">
          <h3 class="title-rule">Conferences</h3>
          <p>Join focused events built around advanced concepts, practical discussion, and clearly defined learning or planning objectives.</p>
          <a class="card-link" href="/conferences">Explore Conferences <span aria-hidden="true">&rarr;</span></a>
        </article>
        <article class="card card--light offering">
          <h3 class="title-rule">Advanced Learning</h3>
          <p>Build a deeper understanding of the strategies, structures, and questions behind important financial decisions.</p>
          {
            learningAvailable ? (
              <a class="card-link" href="/learn">Explore Learning <span aria-hidden="true">&rarr;</span></a>
            ) : (
              <a class="card-link" href="/learn#learning-signup">Get Learning Updates <span aria-hidden="true">&rarr;</span></a>
            )
          }
        </article>
      </div>
    </div>
  </section>

  <!-- 3. Situation-based entry points -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Start with the decision</p>
        <h2>What are you working through?</h2>
        <p class="lead">You do not need to know the name of the strategy. Start with the decision in front of you.</p>
      </div>
      <div class="grid grid--4">
        {
          CATEGORY_SLUGS.map((slug) => {
            const has = countByCategory[slug] > 0;
            return (
              <a class="situation" href={has ? `/advanced-services?category=${slug}#directory` : `/start?subject=${slug}`}>
                <h3 class="title-rule">{CATEGORIES[slug].label}</h3>
                <p>{CATEGORIES[slug].description}</p>
                <span class="situation__cta">
                  {has ? 'View related services' : 'Discuss this with the team'}&nbsp;<span aria-hidden="true">&rarr;</span>
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- 4. Tim and the team -->
  <section class="section section--flush-top">
    <div class="container about">
      <div class="about__media">
        <div class="about__frame">
          <img
            src="/images/tim/tim-berry-suit-600.webp"
            srcset="/images/tim/tim-berry-suit-400.webp 400w, /images/tim/tim-berry-suit-600.webp 600w, /images/tim/tim-berry-suit-768.webp 768w"
            sizes="(min-width: 900px) 420px, 85vw"
            width="768"
            height="800"
            alt="Tim Berry, attorney, in a dark suit with arms crossed"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="about__tag">
          <span class="about__tag-name">Tim Berry</span>
          <span class="about__tag-role">Attorney</span>
        </div>
      </div>
      <div class="about__copy">
        <p class="eyebrow">Tim Berry and the IRA Ideas team</p>
        <h2>Deep experience. A team to move the work forward.</h2>
        <p>IRA Ideas brings attorney Tim Berry's retirement-plan experience together with a coordinated approach to education and specialized services.</p>
        <p>Tim's expertise is central to the work. Our team helps organize the information, communication, and next steps around each engagement.</p>
        <a class="btn btn--primary" href="/about/tim-berry">Meet Tim Berry <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <!-- 5. Experience through change -->
  <section class="section section--tight theme-dark experience">
    <div class="container experience__inner">
      <h2>Advanced planning does not stand still.</h2>
      <p class="lead">
        Retirement planning has evolved throughout the nearly 30 years behind our work. Our approach is to examine the rules, the
        structure, and the facts that matter to the decision in front of you.
      </p>
    </div>
  </section>

  <!-- 6. Proof: shown only when approved proof exists -->
  {
    proof.length > 0 && (
      <section class="section theme-light">
        <div class="container">
          <div class="section-head">
            <h2>See what thoughtful review looks like.</h2>
          </div>
          <div class="grid grid--2">
            {proof.map((t) => (
              <figure class="card proof">
                <blockquote>
                  <p>{t.data.quote}</p>
                </blockquote>
                <figcaption class="muted">{t.data.attribution}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 7. Featured conference -->
  <section class="section theme-darker conference">
    <div class="container conference__grid">
      <div class="conference__event">
        {
          featured ? (
            <EventCard event={featured} feature light />
          ) : (
            <div class="card card--light no-event">
              <h3 class="title-rule">Be first to hear about the next event.</h3>
              <p>Join the priority list for upcoming IRA Ideas conferences, workshops, and private planning sessions.</p>
              <SignupForm list="priority" id="home-priority" />
            </div>
          )
        }
      </div>
      <div class="conference__copy">
        <p class="eyebrow">IRA Ideas Conferences</p>
        <h2>Go deeper in the room.</h2>
        <p class="muted">
          Explore IRA Ideas events designed for focused learning, meaningful discussion, and a clearer understanding of the questions that
          matter to you.
        </p>
        <a class="btn btn--primary" href="/conferences">Explore Conferences</a>
        <div class="cant-wait">
          <p>Have a planning need that cannot wait for an event?</p>
          <a class="btn btn--secondary" href="/start">Discuss My Situation</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Learning preview -->
  <section class="section">
    <div class="container">
      {
        learningAvailable ? (
          <>
            <div class="section-head">
              <p class="eyebrow">IRA Ideas Advanced Learning</p>
              <h2>Understand more before you decide.</h2>
            </div>
            <div class="grid grid--3">
              {resources.map((r, i) => (
                <article class="card">
                  <p class="eyebrow">
                    {CATEGORIES[r.data.topic].label} &middot; {r.data.format}
                  </p>
                  <h3>
                    <a href={`/learn/${r.id}`}>{r.data.title}</a>
                  </h3>
                  <p class="muted small">
                    {resourceAuthors[i]?.data.name}
                    {r.data.duration && <> &middot; {r.data.duration}</>}
                  </p>
                </article>
              ))}
            </div>
            <div class="btn-row learn-more">
              <a class="btn btn--primary" href="/learn">Explore Learning</a>
            </div>
          </>
        ) : (
          <div class="learning">
            <div class="learning__copy">
              <p class="eyebrow">IRA Ideas Advanced Learning</p>
              <h2>Free advanced learning is on the way.</h2>
              <p class="lead">Join the IRA Ideas learning list for new educational resources and announcements as they are released.</p>
            </div>
            <div class="learning__panel theme-dark">
              <SignupForm list="learning" id="home-learning" />
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- 9. Final action -->
  <CtaBand
    heading="Bring us the situation."
    accent="We will help identify the next step."
    copy="Tell our team what you are considering, what is already in place, and any deadline. We will review the request and explain how the work could proceed."
    note="Any proposed paid work will have a defined scope and fee before it begins."
  />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: clamp(48px, 7vw, 80px) 0 0;
    background:
      radial-gradient(ellipse 55% 70% at 78% 40%, rgba(255, 255, 255, 0.07), transparent 70%),
      linear-gradient(160deg, #0f504e 0%, var(--teal) 55%, var(--teal-deep) 100%);
    clip-path: polygon(0 0, 100% 0, 100% 88%, 62% 100%, 0 93%);
    overflow: hidden;
  }
  .hero__grid { display: grid; gap: 32px; align-items: end; }
  @media (min-width: 900px) {
    .hero__grid { grid-template-columns: 1.15fr 1fr; gap: 48px; }
  }
  .hero__copy { padding-bottom: clamp(72px, 10vw, 140px); }
  .hero__eyebrow { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; margin-bottom: 18px; }
  .hero h1 { font-size: clamp(2.3rem, 5vw, 3.6rem); color: #fff; }
  .hero__lead { color: #e3eeed; max-width: 600px; }
  .hero__authority-row { display: flex; align-items: center; gap: 16px; margin: 28px 0 32px; }
  .hero__authority { margin: 0; border-left: 3px solid var(--gold); padding-left: 16px; color: #fff; font-weight: 700; max-width: 540px; }
  .hero__avatar {
    display: none;
    width: 72px;
    height: 72px;
    flex: none;
    object-fit: cover;
    object-position: 50% 6%;
    border-radius: 50%;
    border: 2px solid var(--gold);
    background: var(--teal-deep);
  }
  .hero__visual { position: relative; align-self: end; justify-self: center; width: 100%; max-width: 460px; }
  .hero__photo { width: 100%; height: auto; }
  .hero__nameplate {
    position: absolute;
    left: -12%;
    bottom: 18%;
    background: var(--teal-deep);
    border: 6px solid #fff;
    padding: 20px 24px;
    min-width: 230px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.3);
  }
  .hero__nameplate p { margin: 0; }
  .hero__name { font-family: var(--font-heading); font-weight: 700; font-size: 1.4rem; color: #fff; }
  .hero__role { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); margin-top: 4px !important; }
  .hero__years { font-size: 0.9rem; color: var(--mist); margin-top: 10px !important; max-width: 220px; }
  .hero__meet { display: inline-block; margin-top: 12px; font-weight: 700; font-size: 0.9rem; color: var(--gold) !important; text-decoration: none; }
  .hero__meet:hover { text-decoration: underline; }
  @media (max-width: 899px) {
    .hero { clip-path: polygon(0 0, 100% 0, 100% 96%, 0 100%); }
    .hero__copy { padding-bottom: 8px; }
    .hero__avatar { display: block; }
    .hero__visual { max-width: 360px; justify-self: start; }
    .hero__nameplate { left: auto; right: 0; bottom: 12%; min-width: 0; padding: 14px 18px; border-width: 4px; }
  }

  /* Offerings */
  .offerings-section { border-radius: var(--radius-lg) 0 var(--radius-lg) 0; margin-top: -1px; }
  .offerings { display: grid; gap: 24px; }
  @media (min-width: 900px) {
    .offerings { grid-template-columns: 1.25fr 1fr 1fr; align-items: stretch; }
  }
  .offering h3 { font-size: 1.25rem; }
  .offering--primary { border-top: 5px solid var(--gold) !important; }
  .offering--primary h3 { font-family: var(--font-heading); font-weight: 700; font-size: 1.7rem; }
  .offering__badge {
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--teal-deep);
    color: #fff !important;
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 16px;
  }
  .card-link { font-weight: 700; text-decoration: none; }
  .card-link:hover { text-decoration: underline; }

  /* Situations */
  .situation {
    display: flex;
    flex-direction: column;
    padding: 28px;
    background: var(--light);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .situation:hover { border-color: var(--gold); box-shadow: 0 10px 24px rgba(11, 27, 35, 0.08); color: var(--ink); }
  .situation h3 { font-size: 1.1rem; }
  .situation p { color: var(--slate); font-size: 0.98rem; }
  .situation__cta { margin-top: auto; font-weight: 700; color: var(--gold-deep); font-size: 0.95rem; }

  /* About */
  .section--flush-top { padding-top: 0; }
  .about { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 900px) {
    .about { grid-template-columns: 440px 1fr; gap: 80px; }
  }
  .about__media { position: relative; max-width: 440px; padding: 0 0 28px 28px; }
  .about__media::before { content: ''; position: absolute; left: 0; bottom: 0; width: 70%; height: 70%; background: var(--gold); border-radius: var(--radius); }
  .about__frame {
    position: relative;
    background: linear-gradient(170deg, #145856 0%, var(--teal-deep) 100%);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .about__frame img { width: 100%; height: auto; padding-top: 24px; }
  .about__tag {
    position: absolute;
    right: -12px;
    bottom: 56px;
    background: #fff;
    padding: 12px 18px;
    border-radius: var(--radius);
    box-shadow: 0 10px 24px rgba(11, 27, 35, 0.18);
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .about__tag-name { font-family: var(--font-heading); font-weight: 700; font-size: 1.15rem; }
  .about__tag-role { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--teal); }
  .about__copy { max-width: var(--reading); }
  .about__copy p { color: var(--slate); }
  .about__copy .eyebrow { color: var(--teal); }

  /* Experience */
  .experience__inner { display: grid; gap: 8px 64px; align-items: center; }
  @media (min-width: 900px) {
    .experience__inner { grid-template-columns: 1fr 1.2fr; }
  }
  .experience h2 { margin: 0; }
  .experience .lead { margin: 0; }

  /* Conference */
  .conference__grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) {
    .conference__grid { grid-template-columns: 1.4fr 1fr; gap: 64px; }
  }
  .conference__copy .btn--primary { margin-top: 8px; }
  .cant-wait { margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--line-dark); }
  .cant-wait p { font-weight: 700; color: #fff; }

  /* Learning */
  .learning { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) {
    .learning { grid-template-columns: 1fr 1fr; gap: 72px; }
  }
  .learning__panel { background: var(--teal-deep); padding: clamp(24px, 4vw, 40px); border-radius: var(--radius); }
  .learn-more { margin-top: 32px; }
  .proof blockquote { margin: 0 0 16px; font-family: var(--font-heading); font-size: 1.2rem; }
</style>

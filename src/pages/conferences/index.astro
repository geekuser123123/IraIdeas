---
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import SignupForm from '../../components/SignupForm.astro';
import Icon from '../../components/Icon.astro';
import formatSettings from '../../data/formats.json';
import { listedEvents, isUpcoming, FORMAT_LABELS, FORMAT_POSITIONING } from '../../lib/content';
import { siteImage } from '../../lib/images';
import { bands, bandClass } from '../../lib/bands';

const events = await listedEvents();
const upcoming = events.filter(isUpcoming);
const past = events.filter((e) => e.data.status === 'completed').reverse();

// Positioning lines come from the approved format definitions. The brief
// expects the private strategy intensive to be shared through an unlisted page;
// it is shown here for now and can be switched off in formats.json.
const FORMATS = [
  { key: 'live', icon: 'people', positioning: FORMAT_POSITIONING['live'], copy: 'Educational events on advanced retirement and tax-planning concepts.' },
  { key: 'workshop', icon: 'book', positioning: FORMAT_POSITIONING['workshop'], copy: 'Smaller groups for focused, advanced education and discussion.' },
  { key: 'private-session', icon: 'dots', positioning: FORMAT_POSITIONING['private-session'], copy: 'Limited participation, with preparation and discussion specific to the event.' },
  { key: 'private-intensive', icon: 'person', positioning: FORMAT_POSITIONING['private-intensive'], copy: 'A private engagement with its scope defined for the individual participant.' },
] as const;
const formats = FORMATS.filter((f) => formatSettings[f.key].offered);

// Alternate backgrounds below the dark hero. The priority section always uses
// its light background, so its neighbours are kept white.
const bg = bands(
  [upcoming.length > 0 && 'events', formats.length > 0 && 'formats', 'priority', past.length > 0 && 'past', 'cantWait'],
  { priority: 'light' },
);

const heroImage = siteImage('conferences-hero');
const priorityImage = siteImage('conferences-priority');
---

<Base
  title="Conferences"
  description="IRA Ideas conferences, advanced workshops, and private planning sessions for business owners, investors, and the professionals who advise them."
>
  <section class="conf-hero theme-darker" style={heroImage ? `--hero-image: url('${heroImage}')` : undefined}>
    <div class:list={['conf-hero__bg', { 'conf-hero__bg--image': heroImage }]} aria-hidden="true"></div>
    <div class="container conf-hero__inner">
      <p class="conf-hero__eyebrow">Conferences</p>
      <h1>Advanced ideas. Focused rooms. Practical discussion.</h1>
      <p class="conf-hero__lead">
        Explore IRA Ideas conferences and planning experiences for business owners, investors, and the professionals who advise them.
      </p>
      <a class="btn btn--primary" href={upcoming.length > 0 ? '#events' : '#priority-list'}>View Upcoming Events <Icon name="arrow" size={18} /></a>
    </div>
  </section>

  {
    upcoming.length > 0 && (
      <section class:list={['section', bandClass(bg.events)]} id="events" tabindex="-1">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow-line">Upcoming events</p>
            <h2>Upcoming IRA Ideas events.</h2>
          </div>
          <div class="event-list">
            {upcoming.map((e) => (
              <EventCard event={e} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    formats.length > 0 && (
      <section class:list={['section', bandClass(bg.formats)]}>
        <div class="container">
          <div class="section-head formats-head">
            <p class="eyebrow-line">Event formats</p>
            <h2>{{ 2: 'Two ways to participate.', 3: 'Three ways to participate.', 4: 'Four ways to participate.' }[formats.length] ?? 'Ways to participate.'}</h2>
            <p class="lead">Each format is built around practical discussion and a deeper understanding of advanced retirement and tax strategies.</p>
          </div>
          <div class:list={['formats', `formats--${formats.length}`]}>
            {formats.map((f) => (
              <article class="format">
                <Icon name={f.icon} size={44} class="format__icon" />
                <h3>{FORMAT_LABELS[f.key]}</h3>
                <p class="format__positioning">{f.positioning}</p>
                <p class="format__copy">{f.copy}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="priority" id="priority-list" tabindex="-1" style={priorityImage ? `--priority-image: url('${priorityImage}')` : undefined}>
    <div class:list={['priority__bg', { 'priority__bg--image': priorityImage }]} aria-hidden="true"></div>
    <div class="container priority__grid">
      <div class="priority__copy">
        <h2>Be first to hear about the next event.</h2>
        <p class="lead">Join the priority list for upcoming IRA Ideas conferences, workshops, and private planning sessions.</p>
      </div>
      <div class="priority__panel theme-dark">
        <h2 class="priority__title"><Icon name="mail" size={34} /> Join the Priority List</h2>
        <SignupForm list="priority" id="conferences-priority" stacked />
      </div>
    </div>
  </section>

  {
    past.length > 0 && (
      <section class:list={['section', bandClass(bg.past)]}>
        <div class="container">
          <div class="section-head">
            <h2>Past events</h2>
          </div>
          <div class="event-list">
            {past.map((e) => (
              <EventCard event={e} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class:list={['cant-wait', bandClass(bg.cantWait)]}>
    <div class="container cant-wait__grid">
      <div class="cant-wait__media" aria-hidden="true">
        <img
          src="/images/tim/tim-berry-shirt-600.webp"
          srcset="/images/tim/tim-berry-shirt-400.webp 400w, /images/tim/tim-berry-shirt-600.webp 600w"
          sizes="(min-width: 900px) 300px, 60vw"
          width="600"
          height="714"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="cant-wait__copy">
        <h2>Have a planning need that cannot wait for an event?</h2>
        <p>Tell the IRA Ideas team what you are considering, what is already in place, and any deadline. We will review the request and identify the appropriate next step.</p>
        <a class="btn btn--primary" href="/start">Discuss My Situation <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .eyebrow-line {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .eyebrow-line::after { content: ''; width: 64px; height: 1px; background: var(--ink); }

  /* Hero */
  .conf-hero { position: relative; overflow: hidden; padding: clamp(56px, 8vw, 104px) 0; }
  .conf-hero__bg { position: absolute; inset: 0; }
  .conf-hero__bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 45% 70% at 80% 55%, rgba(255, 180, 0, 0.16), transparent 70%),
      radial-gradient(ellipse 60% 90% at 85% 40%, rgba(12, 67, 66, 0.9), transparent 75%),
      var(--navy);
  }
  .conf-hero__bg--image::before {
    background:
      linear-gradient(90deg, rgba(11, 27, 35, 0.97) 0%, rgba(11, 27, 35, 0.86) 42%, rgba(11, 27, 35, 0.2) 80%, rgba(11, 27, 35, 0.05) 100%),
      var(--hero-image) right center / cover no-repeat;
  }
  @media (max-width: 767px) {
    .conf-hero__bg--image::before {
      background: linear-gradient(180deg, rgba(11, 27, 35, 0.68) 0%, rgba(11, 27, 35, 0.88) 100%), var(--hero-image) 70% center / cover no-repeat;
    }
  }
  .conf-hero__inner { position: relative; }
  .conf-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 18px;
  }
  .conf-hero__eyebrow::after { content: ''; width: 64px; height: 1px; background: rgba(255, 255, 255, 0.6); }
  .conf-hero h1 { color: #fff; font-size: clamp(2.5rem, 5.6vw, 4.3rem); line-height: 1.04; letter-spacing: -0.02em; max-width: 760px; }
  .conf-hero__lead { color: #e3eeed; font-size: 1.15rem; max-width: 560px; margin-bottom: 28px; }

  /* Formats */
  .formats-head { max-width: 820px; }
  .formats-head h2 { font-size: clamp(2.2rem, 4.4vw, 3.4rem); }
  .formats { display: grid; gap: 20px; }
  @media (min-width: 900px) {
    .formats--3 { grid-template-columns: repeat(3, 1fr); }
    .formats--2, .formats--4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1200px) {
    .formats--4 { grid-template-columns: repeat(4, 1fr); }
  }
  .format { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
  .format :global(.format__icon) { color: var(--teal); margin-bottom: 18px; }
  .format h3 { font-family: var(--font-heading); font-weight: 700; font-size: 1.5rem; line-height: 1.2; margin-bottom: 8px; }
  .format__positioning { font-weight: 500; margin-bottom: 10px; }
  .format__copy { color: var(--slate); margin: 0; }

  .event-list { display: grid; gap: 24px; }
  @media (min-width: 1000px) {
    .event-list { grid-template-columns: repeat(2, 1fr); }
  }

  /* Priority list */
  .priority { position: relative; overflow: hidden; padding: clamp(48px, 6vw, 72px) 0; scroll-margin-top: 0; }
  .priority__bg { position: absolute; inset: 0; background: radial-gradient(ellipse 50% 80% at 20% 70%, #ffffff 0%, transparent 70%), linear-gradient(160deg, #eef2f0 0%, #e2e9e6 100%); }
  .priority__bg--image { background: linear-gradient(90deg, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.6) 45%, rgba(255, 255, 255, 0.1) 70%), var(--priority-image) center / cover no-repeat; }
  .priority__grid { position: relative; display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) {
    .priority__grid { grid-template-columns: 1.2fr 1fr; gap: 64px; }
  }
  .priority__copy h2 { font-size: clamp(2.2rem, 4.4vw, 3.4rem); }
  .priority__copy .lead { max-width: 520px; }
  .priority__panel { background: var(--teal); border-radius: var(--radius); padding: clamp(24px, 4vw, 36px); box-shadow: 0 18px 40px rgba(11, 27, 35, 0.2); }
  .priority__title { display: flex; align-items: center; gap: 16px; font-size: 1.8rem; color: #fff; margin-bottom: 20px; }
  .priority__panel :global(.signup-form) { max-width: none; }
  .priority__panel :global(.signup-form .btn) { width: 100%; }
  .priority__panel :global(.signup-form .muted) { color: #d9e6e5; }

  /* Planning need */
  .cant-wait { background: #fff; overflow: hidden; }
  .cant-wait.theme-light { background: var(--light); }
  .cant-wait.theme-light .cant-wait__media::before { background: #dde8e5; }
  .cant-wait__grid { display: grid; gap: 32px; align-items: end; }
  @media (min-width: 900px) {
    .cant-wait__grid { grid-template-columns: 1fr 1.2fr; gap: 64px; align-items: center; }
  }
  .cant-wait__media { position: relative; align-self: end; display: flex; justify-content: center; padding-top: 32px; }
  .cant-wait__media::before { content: ''; position: absolute; left: -10%; right: 10%; bottom: 0; top: 30%; background: #e3eeec; border-radius: 50% 50% 0 0; }
  .cant-wait__media img { position: relative; width: min(300px, 70%); height: auto; }
  .cant-wait__copy { padding: 0 0 48px; }
  @media (min-width: 900px) {
    .cant-wait__copy { padding: 48px 0; }
  }
  .cant-wait__copy h2 { font-size: clamp(1.9rem, 3.4vw, 2.6rem); }
  .cant-wait__copy p { color: var(--slate); max-width: 560px; }
  @media (max-width: 899px) {
    .cant-wait__media { order: 2; }
    .cant-wait__copy { padding-top: 48px; }
  }
</style>

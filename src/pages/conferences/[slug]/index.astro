---
import { getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PhotoHero from '../../../components/PhotoHero.astro';
import PageHero from '../../../components/PageHero.astro';
import SignupForm from '../../../components/SignupForm.astro';
import CtaBand from '../../../components/CtaBand.astro';
import DraftFlag from '../../../components/DraftFlag.astro';
import Icon from '../../../components/Icon.astro';
import { visible, eventAction, formatDates, formatPrice, formatDay, FORMAT_POSITIONING } from '../../../lib/content';
import { bands, bandClass } from '../../../lib/bands';

export async function getStaticPaths() {
  const events = await visible('events');
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const d = event.data;
const instructor = await getEntry(d.instructor);
const isTim = d.instructor.id === 'tim-berry';
const action = eventAction(event);
const dates = formatDates(d.startDate, d.endDate, d.timezone);
const showPriority = d.status === 'announced' || d.status === 'sold-out';
const notice = (d.status === 'postponed' || d.status === 'canceled') && d.statusNotice;
const primary = showPriority ? { label: 'Join the Priority List', href: '#priority-list' } : action;

// "Who the workshop is for", "How the session works", and so on.
const NOUN = { live: 'event', workshop: 'workshop', 'private-session': 'session', 'private-intensive': 'intensive' } as const;
const noun = NOUN[d.format];

type Point = string | { title: string; text: string };
const asPoint = (p: Point) => (typeof p === 'string' ? { title: '', text: p } : p);
const AUDIENCE_ICONS = ['people', 'person', 'briefcase'] as const;
const TOPIC_ICONS = ['document', 'chart', 'people'] as const;
const INCLUDE_ICONS = ['shield', 'document', 'book'] as const;

const phases = [
  d.experience.preparation && { icon: 'document', title: 'Preparation', text: d.experience.preparation },
  d.experience.event && { icon: 'people', title: `At the ${noun}`, text: d.experience.event },
  d.experience.followUp && { icon: 'mail', title: 'Included follow-up', text: d.experience.followUp },
].filter(Boolean) as { icon: 'document' | 'people' | 'mail'; title: string; text: string }[];

const logistics = [
  { icon: 'calendar', label: 'Date', value: `${dates} (Central Time unless noted)` },
  { icon: 'pin', label: 'Venue', value: d.logistics.venue ? `${d.logistics.venue}, ${d.location}` : d.location },
  d.capacity && { icon: 'people', label: 'Capacity', value: d.capacity },
  d.logistics.arrival && { icon: 'car', label: 'Arrival', value: d.logistics.arrival },
  d.logistics.accommodation && { icon: 'bed', label: 'Accommodation', value: d.logistics.accommodation },
  d.logistics.bring && { icon: 'document', label: 'Bring with you', value: d.logistics.bring },
].filter(Boolean) as { icon: 'calendar' | 'pin' | 'people' | 'car' | 'bed' | 'document'; label: string; value: string }[];

const bg = bands([
  d.audience.length > 0 && 'who',
  d.topics.length > 0 && 'topics',
  d.inclusions.length > 0 && 'included',
  phases.length > 0 && 'how',
  instructor && 'instructor',
  'details',
]);

// Structured data only for real, published, listed events.
const eventStatus = { postponed: 'EventPostponed', canceled: 'EventCancelled' } as Record<string, string>;
const jsonLd =
  d.publication === 'published' && !d.unlisted
    ? {
        '@context': 'https://schema.org',
        '@type': 'Event',
        name: d.title,
        description: d.summary,
        startDate: d.startDate,
        endDate: d.endDate ?? d.startDate,
        eventStatus: `https://schema.org/${eventStatus[d.status] ?? 'EventScheduled'}`,
        eventAttendanceMode: `https://schema.org/${d.delivery === 'virtual' ? 'OnlineEventAttendanceMode' : d.delivery === 'hybrid' ? 'MixedEventAttendanceMode' : 'OfflineEventAttendanceMode'}`,
        location:
          d.delivery === 'virtual' ? { '@type': 'VirtualLocation', url: Astro.url.href } : { '@type': 'Place', name: d.logistics.venue ?? d.location, address: d.location },
        organizer: { '@type': 'Organization', name: 'IRA Ideas', url: Astro.site?.href },
        performer: instructor ? { '@type': 'Person', name: instructor.data.name } : undefined,
        ...(d.price != null && ['applications-open', 'registration-open'].includes(d.status)
          ? { offers: { '@type': 'Offer', price: d.price, priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: Astro.url.href } }
          : {}),
      }
    : undefined;
---

<Base title={d.title} description={d.summary} noindex={d.unlisted || d.publication !== 'published'} jsonLd={jsonLd}>
  {
    isTim ? (
      <PhotoHero eyebrow="Conferences" title={d.title} subtitle={`${FORMAT_POSITIONING[d.format]}.`} lead={d.summary} angled={false} labelPrefix="Instructor">
        <Fragment slot="top">
          <nav aria-label="Breadcrumb" class="crumbs">
            <a href="/conferences">Conferences</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{d.title}</span>
          </nav>
          <DraftFlag state={d.publication} />
        </Fragment>
        <Fragment slot="actions">
          {notice && (
            <p class="hero-notice" role="note">
              {notice}
            </p>
          )}
        </Fragment>
      </PhotoHero>
    ) : (
      <PageHero eyebrow="Conferences" title={d.title} lead={d.summary}>
        <DraftFlag state={d.publication} />
        {notice && (
          <p class="hero-notice" role="note">
            {notice}
          </p>
        )}
      </PageHero>
    )
  }

  <!-- Key facts bar, overlapping the hero -->
  <div class="facts-wrap overlay">
    <div class="container">
      <dl class="facts">
        <div>
          <Icon name="calendar" size={30} />
          <span><dt>Dates</dt><dd>{dates}</dd></span>
        </div>
        <div>
          <Icon name="pin" size={30} />
          <span><dt>Location</dt><dd>{d.location}</dd></span>
        </div>
        <div>
          <Icon name="tag" size={30} />
          <span><dt>Price</dt><dd>{formatPrice(d.price)}</dd></span>
        </div>
        <div class="facts__action">
          <Icon name="people" size={30} />
          <span>
            <dt>{showPriority ? 'Get notified' : notice ? 'Status' : 'Participate'}</dt>
            <dd>
              {showPriority
                ? 'Join the priority list for updates.'
                : notice
                  ? d.status === 'canceled'
                    ? 'Canceled'
                    : 'Postponed'
                  : d.status === 'applications-open'
                    ? 'Applications are open.'
                    : d.status === 'registration-open'
                      ? 'Registration is open.'
                      : 'This event has ended.'}
            </dd>
          </span>
          {
            primary && !notice && (
              <a class="btn btn--primary facts__btn" href={primary.href}>
                {primary.label} <Icon name="arrow" size={16} />
              </a>
            )
          }
        </div>
      </dl>
    </div>
  </div>

  {
    d.audience.length > 0 && (
      <section class:list={['section', bandClass(bg.who)]}>
        <div class="container two-col">
          <div>
            <h2>Who the {noun} is for.</h2>
            <p class="lead">
              {FORMAT_POSITIONING[d.format]} for business owners, investors, and the professionals who advise them.
            </p>
          </div>
          <ul class="stack" role="list">
            {d.audience.map(asPoint).map((p, i) => (
              <li class="row-card">
                <Icon name={AUDIENCE_ICONS[i % AUDIENCE_ICONS.length]} size={40} class="row-card__icon" />
                <span>
                  {p.title && <strong class="row-card__title">{p.title}</strong>}
                  <span class="row-card__text">{p.text}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    d.topics.length > 0 && (
      <section class:list={['section', bandClass(bg.topics)]}>
        <div class="container">
          <div class="section-head section-head--center">
            <h2>What participants will work through.</h2>
          </div>
          <ul class="grid-3" role="list">
            {d.topics.map(asPoint).map((p, i) => (
              <li class="row-card">
                <Icon name={TOPIC_ICONS[i % TOPIC_ICONS.length]} size={40} class="row-card__icon" />
                <span>
                  {p.title && <strong class="row-card__title">{p.title}</strong>}
                  <span class="row-card__text">{p.text}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    d.inclusions.length > 0 && (
      <section class:list={['section', bandClass(bg.included)]}>
        <div class="container two-col">
          <div>
            <h2>What is included.</h2>
            <p class="lead">Only the items listed here are part of the participation price.</p>
          </div>
          <ul class="stack" role="list">
            {d.inclusions.map(asPoint).map((p, i) => (
              <li class="row-card">
                <Icon name={INCLUDE_ICONS[i % INCLUDE_ICONS.length]} size={38} class="row-card__icon" />
                <span>
                  {p.title && <strong class="row-card__title">{p.title}</strong>}
                  <span class="row-card__text">{p.text}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    phases.length > 0 && (
      <section class:list={['section', bandClass(bg.how)]}>
        <div class="container">
          <div class="section-head section-head--center">
            <h2>How the experience works.</h2>
          </div>
          <ol class:list={['phases', `phases--${phases.length}`]} role="list">
            {phases.map((ph, i) => (
              <li class="row-card">
                <Icon name={ph.icon} size={40} class="row-card__icon" />
                <span>
                  <strong class="row-card__title">{ph.title}</strong>
                  <span class="row-card__text">{ph.text}</span>
                </span>
                {i < phases.length - 1 && <Icon name="chevron" size={24} class="phases__chevron" />}
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    instructor && (
      <section class:list={['section', bandClass(bg.instructor)]}>
        <div class="container instructor">
          {isTim && (
            <div class="instructor__media">
              <img
                src="/images/tim/tim-berry-shirt-600.webp"
                srcset="/images/tim/tim-berry-shirt-400.webp 400w, /images/tim/tim-berry-shirt-600.webp 600w, /images/tim/tim-berry-shirt-861.webp 861w"
                sizes="(min-width: 900px) 420px, 70vw"
                width="600"
                height="714"
                alt="Tim Berry, attorney"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="instructor__copy">
            <p class="instructor__eyebrow">Your instructor</p>
            <h2>{instructor.data.name}</h2>
            <p class="instructor__role">{instructor.data.role}</p>
            {isTim && <p>Attorney Tim Berry's nearly 30 years of retirement-plan experience are central to IRA Ideas and its events.</p>}
            <a class="btn btn--primary" href={isTim ? '/about/tim-berry' : '/about'}>
              View {isTim ? "Tim's" : 'Full'} Profile <Icon name="arrow" size={18} />
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Schedule, logistics, price, and terms -->
  <section class:list={['section', bandClass(bg.details)]}>
    <div class="container details">
      <div>
        <h2>Schedule &amp; logistics.</h2>
        <table class="table">
          <tbody>
            {
              logistics.map((row) => (
                <tr>
                  <th scope="row">
                    <Icon name={row.icon} size={22} /> {row.label}
                  </th>
                  <td>{row.value}</td>
                </tr>
              ))
            }
            {
              d.schedule.map((row) => (
                <tr>
                  <th scope="row">
                    <Icon name="clock" size={22} /> {row.day}
                  </th>
                  <td>
                    {row.time}: {row.detail}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div>
        <h2>Participation price.</h2>
        <div class="price-box">
          <Icon name="tag" size={28} />
          <div>
            <p class="price-box__amount">{formatPrice(d.price)}</p>
            {
              d.installments && (
                <ul>
                  <li>Deposit: {formatPrice(d.installments.deposit)}</li>
                  <li>
                    Remaining balance: {formatPrice(d.installments.balance)}, due {formatDay(d.installments.balanceDue)}
                  </li>
                  <li>{d.installments.conditions}</li>
                </ul>
              )
            }
            {d.guestPolicy && <p class="price-box__note">{d.guestPolicy}</p>}
          </div>
        </div>
        {
          d.terms.length > 0 && (
            <>
              <h2 class="details__terms">Terms &amp; questions.</h2>
              <div class="faqs">
                {d.terms.map((t) => (
                  <details>
                    <summary>
                      {t.question}
                      <Icon name="chevron" size={18} class="faqs__chevron" />
                    </summary>
                    <p>{t.answer}</p>
                  </details>
                ))}
              </div>
            </>
          )
        }
      </div>
    </div>
  </section>

  {
    showPriority ? (
      <section class="priority-band theme-dark" id="priority-list" tabindex="-1">
        <div class="container priority-band__inner">
          <h2>{d.status === 'sold-out' ? 'This event is sold out.' : 'Be the first to know.'}</h2>
          <p>Join the priority list to receive updates when event details are announced. Joining does not reserve a seat.</p>
          <SignupForm list="priority" id="event-priority" />
        </div>
      </section>
    ) : notice ? (
      <CtaBand heading="Event update" copy={notice} href="/conferences" label="View Conferences" tone="teal" />
    ) : action ? (
      <CtaBand heading={d.title} copy={`${dates} · ${d.location} · ${formatPrice(d.price)}`} href={action.href} label={action.label} tone="teal" />
    ) : null
  }
</Base>

<style>
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.85rem; margin-bottom: 20px; color: var(--mist); }
  .crumbs a { color: #fff !important; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .hero-notice { border-left: 3px solid var(--gold); padding-left: 14px; color: #fff; margin: 0; }

  /* Facts bar overlapping the bottom of the hero */
  .facts-wrap { position: relative; z-index: 2; margin-top: -56px; }
  .facts { display: grid; gap: 18px; margin: 0; background: #fff; border-radius: var(--radius); padding: 22px 24px; box-shadow: 0 16px 40px rgba(11, 27, 35, 0.14); }
  @media (min-width: 1000px) {
    .facts { grid-template-columns: 1fr 1fr 1fr 1.7fr; gap: 0; }
    .facts > div { padding: 0 22px; }
    .facts > div:first-child { padding-left: 0; }
    .facts > div + div { border-left: 1px solid var(--line); }
  }
  .facts > div { display: flex; gap: 14px; align-items: center; }
  .facts :global(svg) { flex: none; color: var(--teal); }
  .facts dt { font-family: var(--font-heading); font-weight: 700; font-size: 1.05rem; }
  .facts dd { margin: 0; color: var(--slate); font-size: 0.9rem; line-height: 1.35; }
  .facts__action > span { flex: 1; }
  .facts__btn { flex: none; min-height: 44px; padding: 10px 18px; font-size: 0.9rem; }
  .facts__btn :global(svg) { color: var(--navy) !important; }
  @media (max-width: 599px) {
    .facts__action { flex-wrap: wrap; }
    .facts__btn { width: 100%; }
  }

  /* Shared layouts */
  .two-col { display: grid; gap: 32px 64px; align-items: start; }
  @media (min-width: 900px) {
    .two-col { grid-template-columns: 1fr 1fr; }
  }
  .two-col h2, .section-head h2, .details h2, .instructor h2 { font-size: clamp(1.9rem, 3.4vw, 2.6rem); }
  .stack, .grid-3, .phases { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .stack li + li, .grid-3 li + li, .phases li + li { margin-top: 0; }
  @media (min-width: 800px) {
    .grid-3, .phases--3 { grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .phases--2 { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }
  .row-card { position: relative; display: flex; gap: 20px; align-items: center; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 22px 24px; }
  .row-card :global(.row-card__icon) { flex: none; color: var(--teal); }
  .row-card__title { display: block; font-family: var(--font-heading); font-weight: 700; font-size: 1.15rem; margin-bottom: 2px; }
  .row-card__text { display: block; color: var(--slate); font-size: 0.95rem; line-height: 1.5; }
  .phases :global(.phases__chevron) { display: none; }
  @media (min-width: 800px) {
    .phases :global(.phases__chevron) { display: block; position: absolute; right: -22px; top: 50%; transform: translateY(-50%); color: var(--ink); background: transparent; }
  }

  /* Instructor */
  .instructor { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) {
    .instructor { grid-template-columns: 1fr 1.1fr; gap: 64px; }
  }
  .instructor__media {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    background: radial-gradient(ellipse 60% 70% at 50% 35%, #ffffff 0%, transparent 70%), linear-gradient(160deg, #e8eeed 0%, #d5e1df 100%);
  }
  .instructor__media img { width: 56%; height: auto; margin-bottom: -4%; }
  .instructor__eyebrow { display: flex; align-items: center; gap: 12px; font-size: 0.78rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--slate); margin-bottom: 8px; }
  .instructor__eyebrow::before { content: ''; width: 16px; height: 1px; background: var(--slate); }
  .instructor h2 { font-size: clamp(2.4rem, 5vw, 3.6rem); margin-bottom: 4px; }
  .instructor__role { color: var(--slate); margin-bottom: 20px; }
  .instructor__copy > p:not([class]) { color: var(--slate); max-width: 520px; }

  /* Details */
  .details { display: grid; gap: 48px; }
  @media (min-width: 900px) {
    .details { grid-template-columns: 1fr 1fr; gap: 64px; }
    .details > div + div { border-left: 1px solid var(--line); padding-left: 64px; }
  }
  .table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--line); font-size: 0.95rem; }
  .table th, .table td { text-align: left; padding: 13px 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .table th { font-weight: 500; white-space: nowrap; width: 42%; }
  .table th :global(svg) { color: var(--teal); vertical-align: -5px; margin-right: 10px; }
  .table td { color: var(--slate); }
  .price-box { display: flex; gap: 18px; align-items: flex-start; background: #eef2f1; border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; }
  .price-box :global(svg) { flex: none; color: var(--teal); }
  .price-box__amount { font-family: var(--font-heading); font-weight: 700; font-size: 1.3rem; margin: 0; }
  .price-box ul { margin: 8px 0 0; color: var(--slate); font-size: 0.95rem; }
  .price-box__note { margin: 8px 0 0; color: var(--slate); font-size: 0.92rem; }
  .details__terms { margin-top: 36px; }
  .faqs details { border: 1px solid var(--line); background: #fff; }
  .faqs details + details { border-top: 0; }
  .faqs details:first-child { border-radius: var(--radius) var(--radius) 0 0; }
  .faqs details:last-child { border-radius: 0 0 var(--radius) var(--radius); }
  .faqs summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 18px; cursor: pointer; font-weight: 500; list-style: none; }
  .faqs summary::-webkit-details-marker { display: none; }
  .faqs :global(.faqs__chevron) { flex: none; transition: transform 0.15s ease; color: var(--teal); }
  .faqs details[open] :global(.faqs__chevron) { transform: rotate(90deg); }
  .faqs details p { padding: 0 18px 16px; margin: 0; color: var(--slate); }

  /* Priority band */
  .priority-band { background: var(--teal); padding: clamp(44px, 5vw, 64px) 0; }
  .priority-band__inner { text-align: center; }
  .priority-band h2 { color: #fff; font-size: clamp(1.9rem, 3.4vw, 2.6rem); margin-bottom: 8px; }
  .priority-band p { color: #e3eeed; max-width: 680px; margin: 0 auto 24px; }
  .priority-band :global(.signup-form) { max-width: 760px; margin: 0 auto; text-align: left; }
  .priority-band :global(.signup-form .muted) { color: #d9e6e5; }
  .priority-band :global(.signup-form .btn) { display: flex; margin: 0 auto; }
</style>

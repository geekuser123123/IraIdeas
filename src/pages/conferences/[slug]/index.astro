---
import { getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PhotoHero from '../../../components/PhotoHero.astro';
import PageHero from '../../../components/PageHero.astro';
import SignupForm from '../../../components/SignupForm.astro';
import CtaBand from '../../../components/CtaBand.astro';
import DraftFlag from '../../../components/DraftFlag.astro';
import Icon from '../../../components/Icon.astro';
import { visible, eventAction, formatDates, formatPrice, formatDay, FORMAT_LABELS, STATUS_LABELS } from '../../../lib/content';
import { bands, bandClass } from '../../../lib/bands';

export async function getStaticPaths() {
  const events = await visible('events');
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const d = event.data;
const instructor = await getEntry(d.instructor);
const isTim = d.instructor.id === 'tim-berry';
const action = eventAction(event);
const dates = formatDates(d.startDate, d.endDate, d.timezone);
const showPriority = d.status === 'announced' || d.status === 'sold-out';
const notice = (d.status === 'postponed' || d.status === 'canceled') && d.statusNotice;
const heroAction = showPriority ? { label: 'Join the Priority List', href: '#priority-list' } : action;

// "Who the workshop is for", "How the session works", and so on.
const NOUN = { live: 'event', workshop: 'workshop', 'private-session': 'session', 'private-intensive': 'intensive' } as const;
const noun = NOUN[d.format];

type Point = string | { title: string; text: string };
const asPoint = (p: Point) => (typeof p === 'string' ? { title: '', text: p } : p);
const AUDIENCE_ICONS = ['person', 'people', 'briefcase'] as const;
const INCLUDE_ICONS = ['document', 'book', 'shield'] as const;

const phases = [
  d.experience.preparation && { title: 'Preparation', text: d.experience.preparation },
  d.experience.event && { title: `The ${noun}`, text: d.experience.event },
  d.experience.followUp && { title: 'Included follow-up', text: d.experience.followUp },
].filter(Boolean) as { title: string; text: string }[];

const logistics = [
  { icon: 'calendar', label: 'Dates', value: `${dates} (Central Time unless noted)` },
  { icon: 'pin', label: 'Location', value: d.logistics.venue ? `${d.logistics.venue}, ${d.location}` : d.location },
  d.capacity && { icon: 'people', label: 'Capacity', value: d.capacity },
  d.logistics.arrival && { icon: 'clock', label: 'Arrival', value: d.logistics.arrival },
  d.logistics.accommodation && { icon: 'briefcase', label: 'Accommodation', value: d.logistics.accommodation },
  d.logistics.bring && { icon: 'document', label: 'What to bring', value: d.logistics.bring },
].filter(Boolean) as { icon: 'calendar' | 'pin' | 'people' | 'clock' | 'briefcase' | 'document'; label: string; value: string }[];

const bg = bands([
  'who',
  d.topics.length > 0 && 'topics',
  d.inclusions.length > 0 && 'included',
  (phases.length > 0 || instructor) && 'how',
  'details',
]);

// Structured data only for real, published, listed events.
const eventStatus = { postponed: 'EventPostponed', canceled: 'EventCancelled' } as Record<string, string>;
const jsonLd =
  d.publication === 'published' && !d.unlisted
    ? {
        '@context': 'https://schema.org',
        '@type': 'Event',
        name: d.title,
        description: d.summary,
        startDate: d.startDate,
        endDate: d.endDate ?? d.startDate,
        eventStatus: `https://schema.org/${eventStatus[d.status] ?? 'EventScheduled'}`,
        eventAttendanceMode: `https://schema.org/${d.delivery === 'virtual' ? 'OnlineEventAttendanceMode' : d.delivery === 'hybrid' ? 'MixedEventAttendanceMode' : 'OfflineEventAttendanceMode'}`,
        location:
          d.delivery === 'virtual' ? { '@type': 'VirtualLocation', url: Astro.url.href } : { '@type': 'Place', name: d.logistics.venue ?? d.location, address: d.location },
        organizer: { '@type': 'Organization', name: 'IRA Ideas', url: Astro.site?.href },
        performer: instructor ? { '@type': 'Person', name: instructor.data.name } : undefined,
        ...(d.price != null && ['applications-open', 'registration-open'].includes(d.status)
          ? { offers: { '@type': 'Offer', price: d.price, priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: Astro.url.href } }
          : {}),
      }
    : undefined;
---

<Base title={d.title} description={d.summary} noindex={d.unlisted || d.publication !== 'published'} jsonLd={jsonLd}>
  {
    isTim ? (
      <PhotoHero eyebrow={FORMAT_LABELS[d.format]} title={d.title} lead={d.summary}>
        <Fragment slot="top">
          <nav aria-label="Breadcrumb" class="crumbs">
            <a href="/conferences">Conferences</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{d.title}</span>
          </nav>
          <DraftFlag state={d.publication} />
        </Fragment>
        <Fragment slot="actions">
          {notice ? (
            <p class="hero-notice" role="note">
              {notice}
            </p>
          ) : (
            heroAction && (
              <a class="btn btn--primary" href={heroAction.href}>
                {heroAction.label} <Icon name="arrow" size={18} />
              </a>
            )
          )}
        </Fragment>
      </PhotoHero>
    ) : (
      <PageHero eyebrow={FORMAT_LABELS[d.format]} title={d.title} lead={d.summary}>
        <DraftFlag state={d.publication} />
        {notice ? (
          <p class="hero-notice" role="note">
            {notice}
          </p>
        ) : (
          heroAction && (
            <div class="btn-row">
              <a class="btn btn--primary" href={heroAction.href}>
                {heroAction.label} <Icon name="arrow" size={18} />
              </a>
            </div>
          )
        )}
      </PageHero>
    )
  }

  <!-- Key facts, then who the event is for -->
  <section class:list={['section', 'who', bandClass(bg.who)]}>
    <div class="container">
      <dl class="facts">
        <div>
          <Icon name="calendar" size={30} />
          <span><dt>Dates</dt><dd>{dates}</dd></span>
        </div>
        <div>
          <Icon name="pin" size={30} />
          <span><dt>Location</dt><dd>{d.location}</dd></span>
        </div>
        <div>
          <Icon name="tag" size={30} />
          <span><dt>Full participation price</dt><dd>{formatPrice(d.price)}</dd></span>
        </div>
        <div>
          <Icon name="people" size={30} />
          <span><dt>Status</dt><dd>{STATUS_LABELS[d.status]}</dd></span>
        </div>
      </dl>

      {
        d.audience.length > 0 && (
          <>
            <div class="section-head section-head--center who__head">
              <h2>Who the {noun} is for.</h2>
            </div>
            <ul class="cards cards--3" role="list">
              {d.audience.map(asPoint).map((p, i) => (
                <li class="card-item">
                  <Icon name={AUDIENCE_ICONS[i % AUDIENCE_ICONS.length]} size={40} class="card-item__icon" />
                  {p.title && <h3>{p.title}</h3>}
                  <p>{p.text}</p>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </section>

  {
    d.topics.length > 0 && (
      <section class:list={['section', bandClass(bg.topics)]}>
        <div class="container">
          <div class="section-head section-head--center">
            <h2>What participants will work through.</h2>
          </div>
          <ol class="cards cards--3" role="list">
            {d.topics.map(asPoint).map((p, i) => (
              <li class="card-item card-item--numbered">
                <span class="card-item__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span>
                  {p.title && <h3>{p.title}</h3>}
                  <p>{p.text}</p>
                </span>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    d.inclusions.length > 0 && (
      <section class:list={['section', bandClass(bg.included)]}>
        <div class="container">
          <div class="section-head section-head--center">
            <h2>What is included.</h2>
            <p class="lead">Only the items listed here are part of the participation price.</p>
          </div>
          <ul class="cards cards--3" role="list">
            {d.inclusions.map(asPoint).map((p, i) => (
              <li class="card-item card-item--row">
                <Icon name={INCLUDE_ICONS[i % INCLUDE_ICONS.length]} size={38} class="card-item__icon" />
                <span>
                  {p.title && <h3>{p.title}</h3>}
                  <p>{p.text}</p>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    (phases.length > 0 || instructor) && (
      <section class:list={['section', bandClass(bg.how)]}>
        <div class="container how">
          {isTim && (
            <div class="how__media">
              <img
                src="/images/tim/tim-berry-shirt-600.webp"
                srcset="/images/tim/tim-berry-shirt-400.webp 400w, /images/tim/tim-berry-shirt-600.webp 600w, /images/tim/tim-berry-shirt-861.webp 861w"
                sizes="(min-width: 900px) 380px, 70vw"
                width="600"
                height="714"
                alt="Tim Berry, attorney"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="how__copy">
            {phases.length > 0 && (
              <>
                <h2>How the {noun} works.</h2>
                <ol class="phases" role="list">
                  {phases.map((ph, i) => (
                    <li>
                      <span class="phases__num" aria-hidden="true">
                        {i + 1}
                      </span>
                      <span>
                        <strong>{ph.title}</strong>
                        <span>{ph.text}</span>
                      </span>
                    </li>
                  ))}
                </ol>
              </>
            )}
            {instructor && (
              <div class="instructor">
                <p>
                  <strong>Instructor:</strong> {instructor.data.name}, {instructor.data.role}
                </p>
                {isTim && (
                  <a href="/about/tim-berry">
                    View Tim Berry's profile <Icon name="arrow" size={16} />
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- Schedule, logistics, price, and terms -->
  <section class:list={['section', bandClass(bg.details)]}>
    <div class="container details">
      <div>
        <h2>Schedule &amp; logistics.</h2>
        <table class="logistics">
          <tbody>
            {
              logistics.map((row) => (
                <tr>
                  <th scope="row">
                    <Icon name={row.icon} size={22} /> {row.label}
                  </th>
                  <td>{row.value}</td>
                </tr>
              ))
            }
            <tr>
              <th scope="row"><Icon name="tag" size={22} /> Full price</th>
              <td>{formatPrice(d.price)}</td>
            </tr>
            {
              d.installments && (
                <>
                  <tr>
                    <th scope="row">
                      <Icon name="tag" size={22} /> Deposit
                    </th>
                    <td>{formatPrice(d.installments.deposit)}</td>
                  </tr>
                  <tr>
                    <th scope="row">
                      <Icon name="calendar" size={22} /> Balance
                    </th>
                    <td>
                      {formatPrice(d.installments.balance)}, due {formatDay(d.installments.balanceDue)}
                    </td>
                  </tr>
                </>
              )
            }
          </tbody>
        </table>
        {d.installments && <p class="small muted">{d.installments.conditions}</p>}
        {d.guestPolicy && <p class="small muted">{d.guestPolicy}</p>}
        {
          d.schedule.length > 0 && (
            <>
              <h3 class="details__sub">Schedule</h3>
              <table class="logistics logistics--schedule">
                <thead>
                  <tr>
                    <th scope="col">Day</th>
                    <th scope="col">Time</th>
                    <th scope="col">Session</th>
                  </tr>
                </thead>
                <tbody>
                  {d.schedule.map((row) => (
                    <tr>
                      <td>{row.day}</td>
                      <td>{row.time}</td>
                      <td>{row.detail}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )
        }
      </div>
      {
        d.terms.length > 0 && (
          <div>
            <h2>Frequently asked questions.</h2>
            <div class="faqs">
              {d.terms.map((t) => (
                <details>
                  <summary>
                    {t.question}
                    <Icon name="chevron" size={18} class="faqs__chevron" />
                  </summary>
                  <p>{t.answer}</p>
                </details>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  {
    showPriority ? (
      <section class="priority-band theme-dark" id="priority-list" tabindex="-1">
        <div class="container priority-band__grid">
          <div>
            <h2>{d.status === 'sold-out' ? 'This event is sold out.' : 'Join the Priority List.'}</h2>
            <p>Be first to know when event details are announced and registration opens. Joining the priority list does not reserve a seat.</p>
          </div>
          <SignupForm list="priority" id="event-priority" stacked />
        </div>
      </section>
    ) : notice ? (
      <CtaBand heading="Event update" copy={notice} href="/conferences" label="View Conferences" layout="split" tone="teal" />
    ) : action ? (
      <CtaBand heading={d.title} copy={`${dates} · ${d.location} · ${formatPrice(d.price)}`} href={action.href} label={action.label} layout="split" tone="teal" />
    ) : null
  }
</Base>

<style>
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.85rem; margin-bottom: 20px; color: var(--mist); }
  .crumbs a { color: #fff !important; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .hero-notice { border-left: 3px solid var(--gold); padding-left: 14px; color: #fff; margin: 0; }

  /* Key facts bar */
  .who { padding-top: 32px; }
  .facts { display: grid; gap: 16px; margin: 0; background: #e7f0ee; border-radius: var(--radius); padding: 20px 24px; }
  @media (min-width: 800px) {
    .facts { grid-template-columns: repeat(4, 1fr); gap: 0; }
    .facts > div + div { border-left: 1px solid #c5d6d2; }
    .facts > div { padding: 0 24px; }
    .facts > div:first-child { padding-left: 0; }
  }
  .facts > div { display: flex; gap: 16px; align-items: center; }
  .facts :global(svg) { flex: none; color: var(--teal); }
  .facts dt { font-weight: 700; font-size: 0.95rem; }
  .facts dd { margin: 0; color: var(--slate); font-size: 0.92rem; }
  .who__head { margin-top: clamp(48px, 6vw, 72px); }

  /* Card grids */
  .section-head--center h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 800px) {
    .cards--3 { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  }
  .cards li + li { margin-top: 0; }
  .card-item { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .card-item :global(.card-item__icon) { color: var(--teal); flex: none; }
  .card-item h3 { font-family: var(--font-heading); font-weight: 700; font-size: 1.3rem; margin: 14px 0 6px; }
  .card-item p { color: var(--slate); font-size: 0.97rem; margin: 0; }
  .card-item--row, .card-item--numbered { display: flex; gap: 18px; align-items: flex-start; }
  .card-item--row h3, .card-item--numbered h3 { margin-top: 0; }
  .card-item__num { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: #e3eeec; font-size: 1.1rem; color: var(--ink); }

  /* How it works */
  .how { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) {
    .how { grid-template-columns: 0.9fr 1.1fr; gap: 64px; }
  }
  .how__media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    background: radial-gradient(ellipse 60% 70% at 50% 35%, #ffffff 0%, transparent 70%), linear-gradient(160deg, #e8eeed 0%, #d5e1df 100%);
  }
  .how__media img { width: 64%; height: auto; margin-bottom: -4%; }
  .how__copy h2 { font-size: clamp(1.9rem, 3.4vw, 2.6rem); }
  .phases { list-style: none; padding: 0; margin: 0 0 24px; }
  .phases li { display: flex; gap: 18px; align-items: flex-start; margin: 0 0 18px; }
  .phases__num { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: #e3eeec; font-weight: 500; }
  .phases strong { display: block; font-family: var(--font-heading); font-size: 1.15rem; }
  .phases span span { display: block; color: var(--slate); font-size: 0.95rem; }
  .instructor { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; border-top: 1px solid var(--line); padding-top: 16px; }
  .instructor p { margin: 0; }
  .instructor a { display: inline-flex; align-items: center; gap: 6px; font-weight: 500; color: var(--teal); }

  /* Details */
  .details { display: grid; gap: 48px; }
  @media (min-width: 900px) {
    .details { grid-template-columns: 1fr 1fr; gap: 64px; }
    .details > div + div { border-left: 1px solid var(--line); padding-left: 64px; }
  }
  .details h2 { font-size: clamp(1.8rem, 3.2vw, 2.4rem); }
  .details__sub { margin-top: 28px; }
  .logistics { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); font-size: 0.95rem; margin-bottom: 12px; }
  .logistics th, .logistics td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .logistics th { font-weight: 500; white-space: nowrap; width: 40%; }
  .logistics th :global(svg) { color: var(--teal); vertical-align: -5px; margin-right: 8px; }
  .logistics td { color: var(--slate); }
  .logistics--schedule th { width: auto; }
  .faqs details { border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .faqs details + details { margin-top: 10px; }
  .faqs summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 18px; cursor: pointer; font-weight: 500; list-style: none; }
  .faqs summary::-webkit-details-marker { display: none; }
  .faqs :global(.faqs__chevron) { flex: none; transform: rotate(90deg); transition: transform 0.15s ease; color: var(--teal); }
  .faqs details[open] :global(.faqs__chevron) { transform: rotate(-90deg); }
  .faqs details p { padding: 0 18px 16px; margin: 0; color: var(--slate); }

  /* Priority band */
  .priority-band { background: var(--teal); padding: clamp(40px, 5vw, 56px) 0; }
  .priority-band__grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 900px) {
    .priority-band__grid { grid-template-columns: 1.1fr 1fr; gap: 64px; }
  }
  .priority-band h2 { color: #fff; font-size: clamp(1.9rem, 3.4vw, 2.6rem); }
  .priority-band p { color: #e3eeed; }
  .priority-band :global(.signup-form .btn) { width: 100%; }
  .priority-band :global(.signup-form .muted) { color: #d9e6e5; }
</style>
